#!/usr/bin/env bash
# The coddy core: the mechanics of the workflow, and the guard that makes
# its rules binding, with no agent dependency. Claude Code reaches it through
# the shims under scripts/, which map its environment onto the inputs below.
#   coddy start  <issue> <branch> [base-issue]   worktree at .worktrees/<issue> on <branch>, from default_branch or the base issue's branch (alias: create)
#   coddy claim  <issue> [--take]   lock the issue for this session, move it to In Progress
#   coddy ship   <issue> [message]  verify, then commit what is uncommitted and push (push: the push alone)
#   coddy state  <issue> [key=value | key+=value ...]   print, or set, the issue's phase state for start and ship
#   coddy verify <issue>            run the config's verify command in the issue's worktree, passing its exit code through
#   coddy diff   <issue>            the worktree's diff against its base (default_branch on the remote, or the stacked issue's branch)
#   coddy log    <issue> <path>...  the last 15 commits on the paths, on the issue's base
#   coddy sweep                     remove what issues with a merged PR left behind
#   coddy status                    the root, the config path and the claimed worktrees, for the prompts
#   coddy config | detect           the config, or NOT_ONBOARDED; facts about the project for onboarding
#   coddy exclude answers | config  put the agent's coddy/ directory, or .coddy.yml, into git's info/exclude unless git ignores it already
#   coddy forget answers            remove the agent's coddy/onboard-answers.json once the config is written
#   coddy migrate                   the config brought up to the current schema version, for /coddy:migrate to write
#   coddy doctor                    the install this runs from (its directory, how it got there, version and commit), a platform: line on native Windows, which coddy does not run on, and, in a project, what is missing or off, one line per check; exit 1 on either
#   coddy guard                     PreToolUse hook on Edit/Write (hooks/hooks.json)
#   coddy snap | trip               Pre/PostToolUse hooks on Bash
#   coddy githook pre-commit|pre-push   the git hooks start installs under .git/hooks/coddy
# Inputs, all optional: CODDY_ROOT, where root resolution starts ($PWD
# without it); CODDY_SESSION and CODDY_PID, the session id and process the
# lock's owner line records and is compared with (a caller naming none is
# not held to the owner); CODDY_AGENT_DIR, the agent's own directory under
# the root, free to edit and skipped by snap, except its worktrees/<name>/,
# held to <name>'s lock (none without it).
# The config is .coddy.yml at the root, or .claude/coddy.yml from before.
# An issue counts as In Progress once the lock .git/coddy/<issue>/ exists.
# Only claim makes it (mkdir, so of two sessions claiming at once one wins;
# a plain-file marker from before locks still counts until the next claim
# replaces it with a lock); its owner file holds "<session> <pid>", and
# another session's claim is refused unless --take is passed or the owner's
# pid no longer runs. The tracker is reached only through MCP tools, so the
# skill moves the issue to In Progress and claim records that it did.
# guard rejects every edit that is not inside a claimed
# worktree, or is inside one another session claimed (with "guard: warn" in
# the config it lets the edit through and says so).
# create records the issue's branch in .git/coddy/<issue>.branch, and push
# pushes that branch and no other, for the lock's owner and no other session.
# snap and trip fingerprint the main checkout around each shell command and
# reject the command's result when it left new changes there, or a new
# worktree outside .worktrees/<issue>/; snap refuses a git worktree add or jj
# workspace add that would make one before it runs, and a git push, git
# send-pack or jj git push to the default branch, a force push or a remote
# branch's delete.
# Those push rules are ported from super-board's hooks/guard-protected-push.py
# (https://github.com/EricTechPro/super-board), MIT License, Copyright (c)
# 2026 Eric Tech: see THIRD_PARTY_NOTICES.md.
set -u
# A CDPATH would send cd elsewhere and echo there, a TMOUT would time out
# every read (bash 5 takes a fraction of a second) and a GREP_OPTIONS would
# rewrite every grep (BSD grep honours it), each leaving a hook to pass.
unset CDPATH TMOUT GREP_OPTIONS

# The target of link $1, an x after it. readlink -n prints it as it is; a
# readlink without -n (BusyBox's, built without FEATURE_READLINK_FOLLOW)
# adds a newline, dropped here, and fails on -n. macOS's adds none after a
# target ending in one, so it is read without -n only when -n fails.
rdl() { local t; t=$(readlink -n "$1" 2>/dev/null && printf x) || { t=$(readlink "$1" && printf x) && case "$t" in *$'\n'x) t=${t%?x}x ;; *) false ;; esac; } && printf %s "$t"; }

# The platform uname -s printed ($1) names: macos, linux, windows (Cygwin,
# MSYS2, Git Bash; WSL is linux) or unknown.
osname() { case "$1" in Darwin) echo macos ;; Linux) echo linux ;; CYGWIN*|MINGW*|MSYS*|Windows_NT) echo windows ;; *) echo unknown ;; esac; }

# The install this runs from: its real directory, through a PATH link or a
# shim that sources it; get.sh's when that is CODDY_HOME. Outside a project
# that is all doctor prints, with a platform: line after it on native
# Windows, which coddy does not run on, and bad, doctor's exit, starting at 1
# there; inside one, the checks after the config guard.
if [ "${1-}" = doctor ]; then
  p="${BASH_SOURCE[0]-}" i=0
  [ -n "$p" ] || { echo "coddy: doctor needs to run from its file, not stdin" >&2; exit 1; }
  case "$p" in */*) ;; *) p="./$p" ;; esac
  while [ -L "$p" ] && [ "$i" -lt 40 ]; do t=$(rdl "$p"); t=${t%x}; case "$t" in /*) p=$t ;; *) p="${p%/*}/$t" ;; esac; i=$((i+1)); done
  d=$(cd -P "${p%/*}/.." && pwd -P) || exit 1
  h=$(cd "${CODDY_HOME:-${HOME-}/.coddy}" 2>/dev/null && pwd -P)
  v=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$d/.claude-plugin/plugin.json" 2>/dev/null | head -1)
  c=""; [ ! -e "$d/.git" ] || c=$(unset GIT_DIR GIT_WORK_TREE; git -C "$d" rev-parse --short HEAD 2>/dev/null)
  echo "install: $d"
  echo "via: $([ "$d" = "$h" ] && echo get.sh || echo other)"
  echo "version: ${v:-unknown}"
  echo "commit: ${c:-none}"
  inst=$d bad=0 u=$(uname -s 2>/dev/null | tr -d '[:cntrl:]')
  [ "$(osname "$u")" != windows ] || { echo "platform: windows ($u) is not supported: coddy runs on macOS, Linux and WSL"; bad=1; }
fi

# Whether git dir $1 is a repository as git tests one, its HEAD read into l:
# a HEAD git takes (a link read as the ref it names), and objects and refs,
# found through a commondir file when there is one (relative to $1, line
# breaks trimmed from its end as git trims them; one that is not a plain
# file, which git dies or hangs on, or is empty fails; objects and refs need
# only be searchable, as git's access(X_OK) has it). Every file is read no
# further than a NUL or 1024 characters, so a huge or sparse one stalls no
# hook, and a HEAD only as far as git reads one (255 bytes; a link's target
# must itself start with refs/).
isgit() {
  local c=$1 m=""
  l=""; if [ -L "$1/HEAD" ]; then l=$(readlink "$1/HEAD"); case "$l" in refs/*) l="ref: $l" ;; *) l="" ;; esac; elif [ -f "$1/HEAD" ]; then { IFS= read -r -d '' -n 1024 l < "$1/HEAD"; } 2>/dev/null; fi
  [[ ${l:0:255} =~ ^(ref:[$' \t\n\r']*refs/|[0-9a-fA-F]{40}) ]] || return 1
  if [ -e "$1/commondir" ]; then
    [ -f "$1/commondir" ] && { IFS= read -r -d '' -n 1024 m < "$1/commondir"; } 2>/dev/null
    m=${m%"${m##*[!$'\n\r']}"}; [ -n "$m" ] || return 1
    case "$m" in /*) c=$m ;; *) c="$1/$m" ;; esac
  fi
  [ -x "$c/objects" ] && [ -x "$c/refs" ]
}
# The project's main checkout, from CODDY_ROOT or the working directory: the
# root, a subdirectory, an issue worktree (git or jj, whose workspace has no
# .git and so reaches the main one) or an agent's own worktree. git names a
# linked worktree's common dir by its real path, so the caller's own spelling
# of it is put back: hook payloads use that one. Outside git, an issue
# worktree is still stripped back to the root.
# A main checkout's git dir is its own: a commondir in it, which git never
# writes there, points every git call in the checkout at another
# repository's config, whose programs (core.fsmonitor) git runs, and moves
# the root there; so does a .git that is a link, or not a directory, at the
# checkout. They are read without git: walking up from $dir past every .git
# directory that is no repository (git walks past those too, isgit) and no
# further than git's own root when that is at or above $dir and git took a .git
# there (not a bare repository's parent: nothing above a .git git took is the
# checkout's), the first .git is the checkout's and a link or a commondir in it is odd, and
# so is the root's own .git, which must be a real directory (whichever way
# the root was found, so a worktree whose own .git is garbage does not skip
# it). odd names what is wrong: the root stays the checkout's (git's root when
# strictly above the link, else the nearest repository above holding a config,
# when the link sits in a subdirectory with none, git failing there or not;
# the root's own link leaves a root holding a config where it is, and moves one
# without to the checkout only if that holds a config; where the nearest
# repository above holds none and git's root does, git's root, so oddly refuses
# without running git: an absorbed submodule's .git file names git's root
# under .git/modules/, which holds none, so the hooks stay inert there as git
# alone left them, and doctor names that .git file rather than a missing
# config), and the
# hooks, which run git outside any sandbox, refuse (oddly), and so does every
# other verb but githook and doctor (see below). A bare repository nested in the
# project does not move the root there when the project's .git is a real
# directory. odd names the
# .git that is odd, whichever root is kept; one above the project is never odd.
# Where git fails the walk stops at
# the project a /.worktrees/ path names, or at a start that holds a config
# itself (a git-less root), never at a repository above it, and the fallback
# (the nearest repository above holding a config) runs only for a start that
# names neither; from a .worktrees/ path the root is the project, odd or not
# (git rejecting a .git planted at or below it leaves the walk stopped there).
# A session in a checkout whose .git is a gitdir: file naming a git dir
# elsewhere (a submodule, a bare repository's worktree) holding a config is
# refused too, its message saying to open the session in the main checkout. A
# linked worktree's own git dir holds a commondir by design. Not caught: a .git file that names a
# whole repository elsewhere, a repository planted where it is the first
# .git up from $dir (src/.git) and the .git file or admin dir of a linked
# worktree rewritten.
# walk: g up from itself to the first .git that is a link, a repository or,
# with $1, any file (a linked worktree's); git failed in a start with $1
# empty, so a garbage .git file there is walked past too. It stops at $stop,
# git's own root (physical) when that is at or above the start and git took a
# .git there (its common dir is that root's own .git, not a bare repository's
# parent), whatever isgit says of it, so nothing above is the checkout's.
walk() {
  while [ -n "$g" ]; do
    if [ -L "$g/.git" ] || { [ -d "$g/.git" ] && { [ -e "$g/.git/commondir" ] || [ -L "$g/.git/commondir" ] || isgit "$g/.git"; }; }; then break
    elif [ -n "${1-}" ] && [ -e "$g/.git" ] && [ ! -d "$g/.git" ]; then break
    elif [ "$g" = "$stop" ]; then break; fi
    case "$g" in */*) g=${g%/*} ;; *) g="" ;; esac
  done
}
legacy=".claude/coddy.yml"
# root: the nearest repository at or above $1 (physical) that holds a config.
upcfg() {
  local g=$1
  while [ -n "$g" ] && ! { [ -d "$g/.git" ] && { [ -f "$g/.coddy.yml" ] || [ -f "$g/$legacy" ]; }; }; do case "$g" in */*) g=${g%/*} ;; *) g="" ;; esac; done
  [ -z "$g" ] || root=$g
}
dir="${CODDY_ROOT:-$PWD}" odd="" proj="" back="" groot="" stop=""
if common=$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null) && root=$(cd "$dir" && cd "$common/.." && pwd); then
  proj=1 groot=$root rel=$(cd "$dir" && pwd -P); g=$rel
  pg=$(cd "$groot" && pwd -P); case "$rel/" in "${pg%/}"/*) [ "$(cd "$dir" && cd "$common" 2>/dev/null && pwd -P)" != "${pg%/}/.git" ] || stop=$pg ;; esac
  walk files
  if [ "$rel" = "$g" ]; then back=$(cd "$dir" && pwd); else back=$g; fi
  if [ -L "$g/.git" ]; then
    odd="$g/.git"; root=$back
  elif [ -d "$g/.git" ] && { [ -e "$g/.git/commondir" ] || [ -L "$g/.git/commondir" ]; }; then
    odd="$g/.git/commondir"; root=$back
  fi
  # A root with no config would switch the hooks off: keep it at git's root
  # when git walked past the link (a root strictly above, not the odd
  # directory git took itself), else at the nearest repository above that
  # holds one.
  if [ -n "$odd" ] && [ ! -f "$root/.coddy.yml" ] && [ ! -f "$root/$legacy" ]; then
    pb=$(cd "$back" && pwd -P)
    case "$pb/" in "$(cd "$groot" && pwd -P)"/?*) root=$groot ;; *) upcfg "$pb" ;; esac
    [ -f "$root/.coddy.yml" ] || [ -f "$root/$legacy" ] || { [ ! -f "$groot/.coddy.yml" ] && [ ! -f "$groot/$legacy" ]; } || root=$groot
  fi
  rel="${rel#"$root"/}"
  case "$dir" in */"$rel") root="${dir%/"$rel"}" ;; esac
else
  root="$dir"; g=$(cd "$dir" 2>/dev/null && pwd) || g=$dir; top=""
  case "$g" in */.worktrees/*) top="${g%%/.worktrees/*}"; root=$top ;; esac
  [ -n "$top" ] || ! { [ -f "$g/.coddy.yml" ] || [ -f "$g/$legacy" ]; } || top=$g
  walk
  # Never above the project a .worktrees/ path names: a repository up there
  # (the project nested in another) is no root of ours.
  [ -z "$g" ] || case "$top/" in "$g"/?*) ;; *) root=$g ;; esac
  # Under a .worktrees/ path (or a git-less root) a repository git rejects, or
  # a link, at or below the project is no root: the odd .git is still named,
  # and the root is the project.
  if [ -n "$top" ] && [ -n "$g" ]; then case "$g/" in "$top"/*)
    if [ -L "$g/.git" ]; then odd="$g/.git"
    elif [ -d "$g/.git" ] && { [ -e "$g/.git/commondir" ] || [ -L "$g/.git/commondir" ]; }; then odd="$g/.git/commondir"; fi ;; esac
  fi
  [ -z "$top" ] || root=$top
fi
# The root's own git dir is held to the same test whichever way the root was
# found: git failing in a worktree whose .git is garbage lands on the second
# branch, with the root's .git untouched. No .git there is a plain jj root.
[ -n "$odd" ] || if [ -e "$root/.git" ] || [ -L "$root/.git" ] || [ -n "$proj" ]; then
  if [ ! -e "$root/.git" ] && [ ! -L "$root/.git" ] && [ -n "$proj" ] && [ ! -f "$root/.coddy.yml" ] && [ ! -f "$root/$legacy" ] && { [ -z "$back" ] || { [ ! -e "$back/.git" ] && [ ! -L "$back/.git" ]; }; }; then
    # a bare repository in no project (git's root, its parent, has no .git and nothing above holds one)
    proj=""
  elif [ -L "$root/.git" ] || [ ! -d "$root/.git" ]; then
    odd="$root/.git"
    [ -f "$root/.coddy.yml" ] || [ -f "$root/$legacy" ] || [ -z "$back" ] || { [ ! -f "$back/.coddy.yml" ] && [ ! -f "$back/$legacy" ]; } || { [ -d "$back/.git" ] && [ ! -L "$back/.git" ]; } || root=$back
    [ -e "$odd" ] || [ -L "$odd" ] || odd="$root/.git"
  elif [ -e "$root/.git/commondir" ] || [ -L "$root/.git/commondir" ]; then odd="$root/.git/commondir"
  fi
fi
# git failing in a start the walk stopped at (a .git link or commondir) lands
# here with the root at that directory: the fallback covers that alone, since
# where git succeeded the root is set above, and from a .worktrees/ path it
# starts at the project, as the strip does, never at the link inside it.
if [ -z "$odd" ] || [ -n "$proj" ]; then :; else
  if [ -n "$top" ]; then root=$top
  elif [ ! -f "$root/.coddy.yml" ] && [ ! -f "$root/$legacy" ]; then upcfg "$(cd "$root" 2>/dev/null && pwd -P || echo "$root")"; fi
fi
# A .git ($1, else odd) that is a gitdir: file (a submodule's, a bare repository's worktree's).
gitlink() { local f=${1-$odd} l=""; case "$f" in */commondir) return 1 ;; esac; [ -L "$f" ] || [ ! -f "$f" ] || { IFS= read -r -d '' -n 1024 l < "$f"; } 2>/dev/null; [[ $l == gitdir:* ]]; }
glmsg="is a file naming a git dir elsewhere, and coddy does not run its hooks in a checkout whose .git points at a git dir elsewhere (a submodule or a bare repository's worktree included)"
# An absorbed submodule's root is the git dir under the superproject's, which has no .git:
# the .git that is odd is the checkout's own gitdir: file.
absorbed=""
if [ "$odd" = "$root/.git" ] && [ ! -e "$odd" ] && [ ! -L "$odd" ] && [ -n "$back" ] && gitlink "$back/.git"; then odd=$back/.git absorbed=1; fi
# The bare repository a session started inside (git's common dir from the start, physical).
bare() { (cd "$dir" && cd "$common" && pwd -P) || printf %s "$odd"; }
# The git_dir: line config, status and detect print, and doctor, in place of their output.
gdmsg() {
  if gitlink; then echo "git_dir: $(printf %s "$odd" | tr -d '[:cntrl:]') $glmsg (fix: open the session in the main checkout, or remove the file by hand if it was not put there on purpose)"
  elif [ ! -e "$odd" ] && [ ! -L "$odd" ]; then echo "git_dir: $(bare | tr -d '[:cntrl:]') is a bare repository nested in the project, so the session started inside it (fix: open the session in the main checkout)"
  else echo "git_dir: $(printf %s "$odd" | tr -d '[:cntrl:]') is not the main checkout's own git dir (fix: remove it$([ -L "$odd" ] || echo ", or put the .git directory back,") by hand)"; fi
}
# .coddy.yml when it exists, else the legacy file; trip asks again after it
# has put the config back.
confpath() { if [ -f "$root/.coddy.yml" ]; then conf="$root/.coddy.yml"; else conf="$root/$legacy"; fi; cname="${conf#"$root"/}"; }
confpath
self="${0##*/}" # how the caller names this command: coddy, or a shim's name
code=1

# With the main checkout's git dir not its own (odd) the root may be another
# repository's, so the verbs the prompts inject say so in one line, exit 0 and
# read nothing from it; every other verb refuses (oddly) before its first git
# call, and sweep, which is only ever injected, is silent.
case "${1-}" in config|detect|status) [ -z "$odd" ] || { gdmsg; exit 0; } ;; esac

if [ "${1-}" = config ]; then
  if [ -f "$conf" ]; then cat "$conf"; else echo "NOT_ONBOARDED"; fi; exit 0
fi

# What is at path $1: file, absent, dir, fifo or other (a dangling link, a
# socket, a device). A link to a file reads as file: the config lock compares
# a link the user keeps through it.
kind() { if [ -f "$1" ]; then echo file; elif [ -d "$1" ]; then echo dir; elif [ -p "$1" ]; then echo fifo; elif [ -e "$1" ] || [ -L "$1" ]; then echo other; else echo absent; fi; }

# Facts about the project that onboarding uses to pre-fill the config so it
# only asks about what it cannot infer. Read-only and never fails loudly.
if [ "${1-}" = detect ]; then
  cd "$root" || exit 0
  echo "root: $root"
  echo "config: $([ -f "$conf" ] && echo present || echo none)"
  echo "legacy_config: $([ -f "$legacy" ] && echo present || echo none)"
  # The first line alone, without control characters or userinfo: a token in
  # the URL, or a line made to read as another fact, would reach the prompt.
  r=$(git remote get-url origin 2>/dev/null | head -n 1 | tr -d '[:cntrl:]' | sed -E 's#^([A-Za-z][A-Za-z0-9+.-]*://)[^/]*@#\1#')
  echo "remote: ${r:-none}"
  echo "jj: $(command -v jj >/dev/null 2>&1 && echo installed || echo missing)"
  echo "jq: $(command -v jq >/dev/null 2>&1 && echo installed || echo missing)"
  # Where this runs and the first package manager on PATH: onboard's install
  # command for a missing jq or jj is keyed on pkg.
  echo "os: $(osname "$(uname -s 2>/dev/null)")"
  p=none; for x in brew apt-get dnf winget; do command -v "$x" >/dev/null 2>&1 && { p=$x; break; }; done
  echo "pkg: $p"
  b=$( (git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main) | sed 's#^origin/##')
  echo "default_branch: $b"
  # A link at AGENTS.md, to a file or dangling, reads as symlink before kind
  # would read through it: onboard writes its block into a plain file alone,
  # since no hook is live before the config and a write through a link lands
  # wherever it points. The PR check's path the same way, a link at .github
  # or .github/workflows included; a plain file is present, nothing is none.
  w=.github/workflows/coddy.yml
  c=$( { [ -L .github ] || [ -L .github/workflows ] || [ -L "$w" ]; } && echo symlink || kind "$w")
  case "$c" in file) c=present ;; absent) c=none ;; esac
  echo "pr_check: $c"
  echo "agents_md: $([ -L AGENTS.md ] && echo symlink || kind AGENTS.md)"
  # Each value read from the repository is one line: a script name, a
  # directory name or a commit subject holding a line break would add a
  # line of its own, root: included, which every onboard path is spelled
  # from. A ref name cannot hold one.
  echo "make_targets: $(grep -ohE '^[A-Za-z][A-Za-z0-9_-]*:' Makefile 2>/dev/null | tr -d : | tr '\n' ' ')"
  echo "package_scripts: $(jq -r '.scripts // {} | keys | join(" ")' package.json 2>/dev/null | tr '\n\r' '  ')"
  echo "go_modules: $(ls go.mod */go.mod 2>/dev/null | tr '\n\r' '  ')"
  echo "roadmap: $(ls ROADMAP.md docs/ROADMAP.md .planning/ROADMAP.md 2>/dev/null | tr '\n' ' ')"
  echo "config_ignored: $(git check-ignore -q .coddy.yml 2>/dev/null && echo yes || echo no)"
  echo "recent_commits:"
  git log --format='  %s' -n 15 2>/dev/null | tr '\r' ' '
  echo "recent_branches:"
  git for-each-ref --sort=-committerdate --format='  %(refname:short)' refs/heads refs/remotes 2>/dev/null | grep -v HEAD | head -8
  exit 0
fi

# When process $1 started, as ps prints it in the C locale and UTC with _ for
# spaces and _UTC after it; empty when ps cannot say (no ps, no such process).
# ps prints it in the locale's language and the local time zone, and the
# guard runs in C: both pinned, so every caller writes and compares one
# format, whatever its LC_ALL or TZ.
started() { [ -n "$1" ] && TZ=UTC0 LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | awk '{$1=$1; gsub(/ /,"_"); print $0 "_UTC"}'; }
# $1 is a start in started's format; one an earlier coddy wrote, in local
# time with no _UTC or in another locale (Do._29_Okt._…), cannot be
# compared, so it counts as unknown.
cstart() { local LC_ALL=C re='^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)_(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)__?[0-9]{1,2}_[0-9]{2}:[0-9]{2}:[0-9]{2}_[0-9]{4}_UTC$'; [[ $1 =~ $re ]]; }
# The process $1 runs, and is the one that started at $2 when that is given:
# a reused pid with another start time is gone. kill -0 needs no ps and sees
# this user's processes; /proc sees everyone's on Linux, where images without
# ps live; ps comes last, so a missing ps never reads as a dead owner, and a
# start time ps cannot read, or one not in started's format, counts as a
# match. No pid counts as running, as claim reads it.
alive() {
  [ -z "$1" ] && return 0
  kill -0 "$1" 2>/dev/null || [ -d "/proc/$1" ] || ps -p "$1" >/dev/null 2>&1 || return 1
  now=$(started "$1"); [ -z "${2-}" ] || [ -z "$now" ] || ! cstart "$2" || [ "$now" = "$2" ]
}
die() { echo "coddy: $*" >&2; exit "$code"; }
cfg() { sed -n "s/^$1:[[:space:]]*//p" "${2:-$conf}" | sed -e $'s/\r$//' -e "s/[[:space:]]*#.*$//; s/[[:space:]]*$//; s/^[\"']//; s/[\"']$//" | head -1; } # key $1, from the config or file $2, a CRLF line's \r and trailing blanks dropped
# The lock's owner ($sid, $pid, $start) is this session ($me): the same
# session id, or the same agent process, since Claude Code's /clear changes
# the id and not the pid; a pid reused since the owner's start is not that process.
mine() { [ "$sid" = "$me" ] || { [ -n "$pid" ] && [ "$pid" = "${CODDY_PID-}" ] && alive "$pid" "$start"; }; }
# Issue $1's owner line, as claim wrote it ("<session> <pid> <start>"), into
# $own, $sid, $pid and $start; all empty for a plain-file marker or a lock with
# no owner yet, and $start for a line written before start times.
owner() { own=$(cat "$root/.git/coddy/$1/owner" 2>/dev/null); read -r sid pid start _ <<<"$own"; }
# This session's owner line.
myline() { echo "$me ${CODDY_PID-} $(started "${CODDY_PID-}")"; }
# jq for the hooks: HOME=/dev/null, so a ~/.jq (loaded into every program)
# is never read. Not named jq, so command -v jq still finds the real one.
jqh() { HOME=/dev/null jq "$@"; }
# Hook context for the agent, as Claude Code reads it: no permissionDecision,
# so the usual permission flow still applies.
note() { jqh -cn --arg m "$*" '{hookSpecificOutput: {hookEventName: "PreToolUse", additionalContext: $m}}'; }
# guard: warn lets the $1 (edit, command) through and hands the agent die's
# message as context instead.
warnmode() { [ "$(cfg guard)" = warn ] || return 0; wm=$1; die() { note "coddy warning, the $wm was let through (guard: warn): $*"; exit 0; }; }
# The hooks run git outside any sandbox: with the main checkout's git dir
# not its own (odd) they run none and refuse every edit and command, in
# either guard mode, after trip's report so far, $1.
oddly() {
  [ -n "$odd" ] || return 0
  code=2
  case "$odd" in
    */commondir) die "${1-}$odd, which git never writes in a main checkout, points git there at another repository, whose config can run a program outside the sandbox, so coddy refuses every edit and command until you remove that file by hand." ;;
    *) [ ! -L "$odd" ] || die "${1-}$odd is a link, so git there reads another repository, whose config can run a program outside the sandbox, so coddy refuses every edit and command until you remove it by hand."
       ! gitlink || die "${1-}$odd $glmsg, so it refuses every edit and command until you open the session in the main checkout, or remove the file by hand if it was not put there on purpose."
       [ -e "$odd" ] || die "${1-}$(bare) is a bare repository nested in the project, so $odd does not exist and the session started inside it, where git reads another repository, whose config can run a program outside the sandbox, so coddy refuses every edit and command until you open the session in the main checkout."
       die "${1-}$odd is not a directory, so git there reads another repository, whose config can run a program outside the sandbox, so coddy refuses every edit and command until you put the main checkout's .git directory back by hand." ;;
  esac
}

# Onboarding's one write outside the agent dir, here so the skill's command
# text holds no path and no wildcard: the agent's coddy/ directory (answers,
# backups) or .coddy.yml (a personal config) goes into git's info/exclude,
# unless git ignores it already. The directory pattern has no trailing
# slash: a directory-only pattern does not match the path while the
# directory is absent, and the line would be added on every run.
if [ "${1-}" = exclude ]; then
  oddly
  case "${2-}" in
    answers) [ -n "${CODDY_AGENT_DIR-}" ] || die "exclude answers needs CODDY_AGENT_DIR"; p="$CODDY_AGENT_DIR/coddy" ;;
    config) p=.coddy.yml ;;
    *) die "usage: $self exclude answers|config" ;;
  esac
  cd "$root" || die "cannot enter $root"
  git check-ignore -q "$p" 2>/dev/null && { echo "ignored already: $p"; exit 0; }
  # A last line without its newline would take the pattern as its tail.
  x=$(git rev-parse --git-path info/exclude 2>/dev/null) && mkdir -p "${x%/*}" && { [ ! -s "$x" ] || [ -z "$(tail -c1 "$x")" ] || echo; echo "$p"; } >> "$x" || die "could not write $p to git's info/exclude"
  echo "excluded: $p"; exit 0
fi

# The project root and its claimed issue worktrees, injected by /coddy:start,
# /coddy:ship, /coddy:config and /coddy:next. A directory under .worktrees/
# counts only once claim has recorded it, so worktrees coddy did not create
# are never listed. Each is printed as issue=branch, with the branch create
# recorded; under bases as issue=branch when create stacked it on another
# issue's branch, which ship makes the PR's base; and under owners as
# issue=<owner>: me when the lock is this session's (mine), another
# session's id with (running) or (gone) by its pid (alive), or unknown for a
# marker from before locks or an owner line that names no session.
# Read-only and never fails loudly: its output is the prompt.
if [ "${1-}" = status ]; then
  cd "$root" || exit 0
  me="${CODDY_SESSION-}" ws="" bases="" owners=""
  for d in .worktrees/*/; do
    n=$(basename "$d"); [ -e ".git/coddy/$n" ] || continue
    b=$(cat ".git/coddy/$n.branch" 2>/dev/null); ws="$ws$n${b:+=$b} "
    b=$(cat ".git/coddy/$n.base" 2>/dev/null); [ -z "$b" ] || bases="$bases$n=$b "
    owner "$n"
    if [ -z "$sid" ]; then o=unknown; elif mine; then o=me; elif alive "$pid" "$start"; then o="$sid (running)"; else o="$sid (gone)"; fi
    owners="$owners$n=$o "
  done
  echo "root: $root"
  echo "config: $([ -f "$conf" ] && echo "$cname" || echo none)"
  echo "jj_repo: $([ -d .jj ] && echo yes || echo no)"
  echo "worktrees: $ws"
  echo "bases: $bases"
  echo "owners: $owners"
  exit 0
fi

# $1 made absolute against $2, . and .. collapsed by name as cd does, and its
# longest existing directory spelled physically, as git and jj record it.
abspath() {
  local p=$1 o="" c t=""
  case "$p" in /*) ;; *) p="$2/$p" ;; esac
  while [ -n "$p" ]; do p=${p#/}; c=${p%%/*}; p=${p#"$c"}; case "$c" in ''|.) ;; ..) o=${o%/*} ;; *) o="$o/$c" ;; esac; done
  p=${o:-/}
  while [ ! -d "$p" ]; do t="/${p##*/}$t"; p=${p%/*}; p=${p:-/}; done
  p=$(cd "$p" 2>/dev/null && pwd -P && printf x) || return 1; p=${p%?x}
  p="${p%/}$t"; echo "${p:-/}"
}

if [ "${1-}" = guard ]; then
  # Byte-wise, before the payload is read: under Shift_JIS, GBK or GB18030
  # (LC_ALL, LC_CTYPE or LANG, which an env can set) a path ending in a lead
  # byte takes the x put after it below as a trail byte, and ${f%x} keeps it.
  export LC_ALL=C
  # Seconds the walk below (phys) may take, from here, well inside any hook
  # timeout: a cancelled hook lets the edit through. Reset, not read, as an
  # environment can set SECONDS.
  budget=5 SECONDS=0
  [ -f "$conf" ] || exit 0
  code=2 # exit 2 is what blocks the tool call
  oddly
  # Without jq, with one that fails or with a payload naming no path, the
  # path cannot be read, so every edit is blocked, in warn mode too:
  # .coddy.yml must never go through unasked. So the payload is read before
  # warnmode, whose die lets the edit through.
  command -v jq >/dev/null || die "the edit guard needs jq"
  # The hook's session_id is the editing session's CODDY_SESSION.
  # jq once per field, not read per line: a path may hold a newline. $(...)
  # strips trailing ones, so a path ends in an x it then drops, here and from
  # phys and inroot below (abspath's own line ends in a newline).
  in=$(cat)
  me=$(jqh -r '.session_id // ""' <<<"$in") &&
    f=$(jqh -j '.tool_input.file_path // .tool_input.notebook_path // empty' <<<"$in" && printf x) &&
    cwd=$(jqh -j '.cwd // empty' <<<"$in" && printf x) || die "the edit guard could not read the hook payload with jq"
  f=${f%x} cwd=${cwd%x}
  [ -n "$f" ] || die "the edit guard could not read a path from the hook payload"
  # Reading a path below takes time quadratic in its length, and a hook that
  # outlasts its timeout lets the edit through, so one longer than any path
  # a kernel opens (4096 bytes) is refused first, in warn mode too. That
  # bounds the path's length; $budget bounds the walk's time.
  long() { [ "${#1}" -gt 4096 ]; }
  ! long "$f" && ! long "$cwd" || die "the edit guard refuses a path or cwd longer than 4096 bytes"
  # Native Windows (Git Bash, MSYS2, Cygwin) hands the path and the cwd as
  # D:\proj\x, D:/proj/x, D:x or //server/share/x (//./D:/x, //?/D:/x),
  # none of which the code below reads as Windows does. A drive letter or a
  # backslash reads as relative: joined to an absolute cwd, or to $PWD for
  # an empty one, the edit was held as a path under that directory, and
  # passed when that was outside the project, in the agent dir or in a
  # claimed worktree, while the tool wrote the Windows path itself; a
  # leading // reads as a path outside the project. coddy runs on macOS,
  # Linux and WSL, so each is refused, in warn mode too, and so is a cwd
  # neither empty nor absolute, an object or array jq prints as JSON text
  # included, which abspath's unset $2 under set -u refused only by accident.
  for x in "$f" "$cwd"; do case "$x" in [A-Za-z]:*|//[!/]*|*\\*) die "the edit guard refuses a Windows path (a drive letter, a backslash or a leading //) in $f or its cwd ${cwd:-none}: coddy runs on macOS, Linux and WSL, not on native Windows." ;; esac; done
  case "$cwd" in ''|/*) ;; *) die "the edit guard refuses a cwd that is not an absolute path: $cwd" ;; esac
  # A relative path is written against the hook's cwd, as the tool resolves it.
  case "$f" in ''|/*) ;; *) f="${cwd:-$PWD}/$f" ;; esac
  # The physical path a write to $1 lands on: symlinks followed in every
  # component (a dangling one creates its target), ./, // and .. resolved as
  # the kernel does (a .. after a link climbs from its target), the last
  # component left as it is unless it is a link. Walked a component at a
  # time, each tested from inside its parent and each link read there, its
  # target walked the same way: a directory and a target glued into one
  # path may pass PATH_MAX, which reads as no entry and no link. Fails when
  # a directory does not exist, or, with $2 new, joins the rest to it by
  # name, as the tool makes it, with no test on disk (nothing is there past
  # a missing directory); and fails on any step that does: a cd, a readlink,
  # a 41st link (40, as far as a kernel follows), once $budget seconds have
  # passed (each cd costs time in the depth), a .. in that rest (nothing to
  # climb from), and a joined tail past 4096 bytes (the join costs time
  # quadratic in its length, and links repeat it).
  phys() (
    set -f; comps "$1"; a=("${b[@]}")
    case "$1" in /*) cd / 2>/dev/null || exit 1 ;; esac
    k=0 i=0 c=""
    while [ "$k" -lt "${#a[@]}" ]; do
      [ "$SECONDS" -lt "$budget" ] || exit 1
      c=${a[k]}; k=$((k+1))
      if [ -n "$c" ] && [ -L "./$c" ]; then
        [ "$i" -lt 40 ] || exit 1; i=$((i+1))
        t=$(rdl "./$c") || exit 1; t=${t%x}
        case "$t" in /*) cd / 2>/dev/null || exit 1 ;; esac
        comps "$t"; a=("${b[@]}" "${a[@]:k}"); k=0 c=""; continue
      fi
      [ "$k" -lt "${#a[@]}" ] || break
      case "$c" in ''|.) continue ;; esac
      if [ -d "./$c" ]; then cd -P "./$c" 2>/dev/null || exit 1
      elif [ "${2-}" = new ]; then
        t=$(pwd -P && printf x) || exit 1; t=${t%?x}
        t=${t%/}
        for c in "${a[@]:k-1}"; do case "$c" in ''|.) ;; ..) exit 1 ;; *) t="$t/$c"; ! long "$t" && [ "$SECONDS" -lt "$budget" ] || exit 1 ;; esac; done
        printf '%sx' "$t"; exit
      else exit 1; fi
    done
    t=$(pwd -P && printf x) && printf '%s/%sx' "${t%?x}" "$c"
  )
  # $1's components into b, a trailing / as a last empty one. IFS is / for
  # the split alone: bash 3.2 joins a quoted "${a[@]:k}" under it.
  comps() { IFS=/; b=($1); IFS=$' \t\n'; case "$1" in */) b+=("") ;; esac; }
  # The off switch for every hook here, and no sensitive-file prompt of the
  # agent's own: the user allows each edit of it, in both modes, by whatever
  # path the write reaches it: its own spelling or one with ./, // or ..; a
  # symlink or hard link from a worktree or the agent dir (-ef: the same
  # file); any case of its name, as a case-folding disk reads it.
  # The Write tool collapses $f's own . and .. by name before it writes, so
  # they are collapsed here first (abspath, $nm), and the links then followed;
  # the hard-link test stats $nm too, never a link's .. the write does not
  # take. A path the walk cannot follow is refused here, before warnmode, as
  # the payload is: let through, a write could land on a .coddy.yml not made
  # yet (the legacy file live) that nothing asked about.
  # The root's directory is compared by identity (-ef), not by name: macOS
  # reaches it through the /System/Volumes/Data firmlink too, which bash's
  # pwd -P keeps, as it would a bind mount.
  nf="the edit guard could not follow $f to where the edit lands (a cd or readlink failed, more than 40 links, a path past 4096 bytes, a .. after a missing directory, or more than $budget seconds)."
  nm=$(abspath "$f" && printf x) && nm=${nm%?x} && at=$(phys "$nm" new) && at=${at%x} || die "$nf"
  warnmode edit
  pr=$(cd "$root" && pwd -P && printf x) && pr=${pr%?x} || pr=$root
  if [ "$nm" -ef "$root/.coddy.yml" ] || { [ "${at%/*}" -ef "$pr" ] && [ "$(printf %s "${at##*/}" | tr '[:upper:]' '[:lower:]')" = .coddy.yml ]; }; then
    jqh -cn --arg m "Editing .coddy.yml changes the coddy guardrails. Allow it only if you asked for this change (/coddy:config)." '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $m}}'
    exit 0
  fi
  case "$f" in */../*) die "refusing a path containing '..': $f" ;; esac
  agent="${CODDY_AGENT_DIR-}"
  # held <path> <root>: dies unless an edit of <path>, read against <root>,
  # may go ahead.
  held() {
    local f=$1 root=$2 issue=""
    move=""
    case "$f" in
      "$root"/.worktrees/*) issue="${f#"$root"/.worktrees/}" ;;
      "$root"/*)
        # The agent's own directory is free, except its worktrees/<name>/,
        # held to <name>'s lock as .worktrees/<name>/ is, or an unclaimed edit
        # could hide there.
        [ -z "$agent" ] || case "${f#"$root"/}" in
          "$agent"/worktrees/*) issue="${f#"$root/$agent"/worktrees/}" ;;
          "$agent"/*) return 0 ;;
        esac
        [ -n "$issue" ] || die "edits belong in an issue worktree, not the main checkout. Run /coddy:start <issue>, then edit under .worktrees/<issue>/." ;;
    esac
    [ -n "$issue" ] || return 0 # outside the project
    issue="${issue%%/*}"
    [ -e "$root/.git/coddy/$issue" ] || die "issue $issue is not In Progress yet. Run /coddy:start $issue."
    # A lock with no owner line is a claim in flight, or one that died between
    # its mkdir and that line.
    [ ! -d "$root/.git/coddy/$issue" ] || [ -s "$root/.git/coddy/$issue/owner" ] || die "issue $issue's claim is in flight or died halfway. Run /coddy:start $issue."
    # The lock's owner, as claim wrote it; a plain-file marker has none. A
    # claim run by hand, or a hook payload without session_id, names no
    # session, and then the edit is not held to the owner.
    owner "$issue"
    [ -z "$sid" ] || [ -z "$me" ] || mine ||
      die "the worktree of issue $issue belongs to session $sid (pid $pid, $(alive "$pid" "$start" && echo running || echo "not running")). Run /coddy:start $issue to take it over, or work on your own issue."
    # The owner's edit from a new session id (/clear) or process (--resume)
    # moves the lock along, as its re-claim would: a pid left behind reads
    # as a dead owner to every other session. Only once both readings below
    # allow the edit, so $move names the issue whose owner line moves.
    [ -z "$sid" ] || [ -z "$me" ] || [ "$own" = "$(myline)" ] || move=$issue
  }
  # $1 with its deepest ancestor that is the root directory itself (-ef)
  # spelled $pr: the root has names no link shows (the firmlink above, a
  # bind mount), which no match on $pr's spelling would read as the project.
  # Fails once $budget seconds have passed, as phys does: each step costs
  # time in the path's length.
  inroot() { local a=$1; while [ "${a%/*}" != "$a" ]; do [ "$SECONDS" -lt "$budget" ] || return 1; a=${a%/*}; [ "${a:-/}" -ef "$pr" ] && { printf '%sx' "$pr${1#"$a"}"; return; }; done; printf '%sx' "$1"; }
  # Claude Code hands the hooks the physical project dir, while a path may
  # reach the project through a link, or the root be one: the edit is held
  # as given against the root, then spelled physically (phys, new for a
  # directory not made yet) against the physical root, found by identity
  # (inroot), and either may refuse it; the second only when either spelling
  # differs, since it would repeat the first. A path phys cannot follow here
  # is refused, as given it may land anywhere, and under guard: warn is
  # advice like any other hold (only the .coddy.yml walk above is refused in
  # both modes).
  held "$f" "$root"; m=$move
  # Not $at: abspath collapses a trailing /. or /.. by name.
  g=$(phys "$f" new) && g=$(inroot "${g%x}") || die "$nf"
  g=${g%x}
  [ "$g" = "$f" ] && [ "$pr" = "$root" ] || held "$g" "$pr"
  [ -z "$m" ] || myline > "$root/.git/coddy/$m/owner" 2>/dev/null
  [ -z "$move" ] || [ "$move" = "$m" ] || myline > "$root/.git/coddy/$move/owner" 2>/dev/null
  exit 0
fi
# Where shell command $1, run in directory $2, would make a worktree with git
# worktree add or jj workspace add: one absolute path per line (abspath), or
# ?<word> for one its text cannot fix. Read as the shell reads it, in awk for
# speed and in time linear in the text: segments split on ; & | ( ) and line
# breaks; quotes, backslashes, comments, redirections and heredoc bodies
# taken apart; a $( or backtick
# substitution, quoted or not, read as commands of its own and as one word
# its text cannot fix in the command around it, whose words after it stay
# in it, a backtick one ending at the first backtick no backslash escapes,
# whatever quotes it crosses, and one still open at the end of the text
# closed there; a heredoc fed to a shell (sh, bash, dash, ksh or zsh reading
# its script from stdin) read in place as commands, however deep, in the
# directory at that point, a cd in it kept to it; VAR=value prefixes,
# reserved words and the env, command, builtin, exec, nohup, time, timeout,
# nice and xargs wrappers skipped, with each option that takes a value and
# timeout's duration (env -C followed), and a word of unquoted substitutions
# alone, which may expand to nothing and bash then drops, so the word after
# it is read as the command, as is a command name past the unquoted
# substitutions it starts with (? or :? for one that cannot be fixed
# either); a literal cd or pushd followed (a subshell's dropped at its
# parenthesis; a popd, or a cd or pushd reached past such a word or
# substitution, which then may be the command bash runs, leaves the
# directory unknown), and git -C; each git or jj option that
# takes a value skipped with it. $var, a substitution, a glob, a brace, ~, a
# line break and a cd it cannot follow leave a word unresolved. Another
# check of a command's text matches its own commands in run: a git push, git
# send-pack or jj git push (git-push and git-send-pack by any path; under a
# -c help.autocorrect, a subcommand one edit from push) prints, after a
# colon, what it would do (push): :to <branch>; HEAD, @ and a git push with
# no refspec read as the branch checked out where it runs (:here, branchin)
# or in the git dir --git-dir or GIT_DIR names (:gd), unless the command's
# -c remote.<name>.push or push.default=matching says otherwise; :glob
# <pattern> for a refspec pattern; :all for every branch; :force; :delete;
# :? <word> for a target its text cannot fix; nothing for a dry run, -h or
# a git -v before the subcommand.
adds() {
  # Byte-wise, as the guard reads: the x after each abspath is stripped below.
  local -x LC_ALL=C
  local p d q
  d=$(cd "$2" 2>/dev/null && pwd -P) || d=$2
  while IFS= read -r p; do
    case "$p" in
      ":here "*) p=$(abspath "${p#:here }" "$d" && printf x) && p=${p%?x} && [[ $p != *$'\n'* ]] && p=$(branchin "$p") || { echo ":? HEAD"; continue; }; [ -z "$p" ] || echo ":to $p" ;;
      ":gd "*) p=$(abspath "${p#:gd }" "$d" && printf x) && p=${p%?x} && [[ $p != *$'\n'* ]] && p=$(isgit "$p" && headref) || { echo ":? HEAD"; continue; }; [ -z "$p" ] || echo ":to $p" ;;
      \?*|:*) echo "$p" ;;
      # A directory name ending in a newline would split the path in two.
      *) q=$(abspath "$p" "$d" && printf x) && case "${q%?x}" in *$'\n'*) false ;; esac && echo "${q%?x}" || echo "?$p" ;;
    esac
  done < <(printf '%s\n' "$1" | LC_ALL=C awk '
    function path(b, p) { return p ~ /^\// ? p : b == "" ? "" : b "/" p }
    # A line of the push being read, held in pb until it is known to push.
    function put(l) { pb = pb l "\n" }
    # A tagged line, unresolved when s spans lines, so no line reads as a path.
    function say(tag, s) { if (s ~ /\n/) { tag = ":?"; gsub(/\n/, " ", s) } put(tag " " s) }
    # a is one edit (an insert, a delete, a substitution or a transposition)
    # from b.
    function typo(a, b,   x, y, i) {
      x = length(a); y = length(b)
      if (a == b || x - y > 1 || y - x > 1) return 0
      for (i = 1; substr(a, i, 1) == substr(b, i, 1); i++) ;
      if (x != y) return x > y ? substr(a, i + 1) == substr(b, i) : substr(a, i) == substr(b, i + 1)
      return substr(a, i + 1) == substr(b, i + 1) || substr(a, i, 2) == substr(b, i + 1, 1) substr(b, i, 1) && substr(a, i + 2) == substr(b, i + 2)
    }
    # The -c remote.<name>.push values the command gives remote r (any
    # remote when r is ""), each after a \035; pm when its last -c
    # push.default is matching.
    function conf(r,   C, N, i, x, v, s) {
      pm = 0; N = split(cf, C, "\035")
      for (i = 2; i <= N; i++) {
        x = C[i]; v = ""; if (index(x, "=")) { v = substr(x, index(x, "=") + 1); x = substr(x, 1, index(x, "=") - 1) }
        if (tolower(x) == "push.default") pm = v == "matching"
        else if (x ~ /^[Rr][Ee][Mm][Oo][Tt][Ee]\..+\.[Pp][Uu][Ss][Hh]$/ && (r == "" || substr(x, 8, length(x) - 12) == r)) s = s "\035" v
      }
      return s
    }
    # Where HEAD reaches, as word x of a push run in g: the branch checked out
    # there, or in the git dir --git-dir or GIT_DIR names (gd; ? when its text
    # cannot be fixed), resolved against g.
    function head(g, x,   p) {
      p = gd == "" ? g : gd == "?" ? "" : path(g, gd)
      if (p == "") say(":?", x); else say(gd == "" ? ":here" : ":gd", p)
    }
    # Refspec x, xb when its text cannot be fixed: [+]<src>[:<dst>], whose
    # dst is src when it has none; a quoted * makes it a pattern git matches
    # against whole ref names.
    function ref(x, xb, g,   s, c, d) {
      if (xb) { say(":?", x); return }
      s = x; if (s ~ /^\+/) { put(":force"); s = substr(s, 2) }
      if (s == ":") { al = 1; return }
      c = index(s, ":"); if (c == 1) dl = 1
      d = c ? substr(s, c + 1) : s; if (d == "") d = substr(s, 1, c - 1)
      if (d == "HEAD" || d == "@") head(g, x)
      else if (index(d, "*")) say(":glob", d)
      else { sub(/^(refs\/)?heads\//, "", d); if (d !~ /^refs\//) say(":to", d) }
    }
    # What the git push, git send-pack (sp) or jj git push whose subcommand
    # is word j, run in directory g ("" when unknown), would push, each by its
    # own options: git long ones by any prefix, as git takes them, each
    # undone by a later --no- form (--no-force-with-lease every lease, and
    # --no-mirror a git push -f too). Nothing for a dry run or -h, which
    # push nothing.
    function push(j, t, g, sp, dd,   x, c, m, v, vb, n, s, tg, any, dr, r, rb, R, N, u, hp, fo, le, de, pr, mi, ao, si) {
      pb = ""; al = dl = 0
      for (j++; j <= k; j++) {
        x = seg[j]
        if (!dd && x == "--") { dd = 1; continue }
        if (t == "jj") {
          if (dd) continue
          if (x == "--dry-run" || x == "--help" || x == "-h") { dr = 1; continue }
          v = ""; vb = 0
          if (x ~ /^--/) {
            c = x; sub(/=.*/, "", c)
            if (x ~ /=/) { v = substr(x, index(x, "=") + 1); vb = bad[j] }
            else if (c ~ /^--(remote|bookmark|tag|revisions?|change|named|option|repository|at-operation|at-op|color|config|config-toml|config-file)$/) { v = seg[++j]; vb = bad[j] }
          } else if (x ~ /^-./) {
            for (m = 2; m <= length(x); m++) if (index("btrcoR", c = substr(x, m, 1))) {
              if (m < length(x)) { v = substr(x, m + 1); sub(/^=/, "", v); vb = bad[j] } else { v = seg[++j]; vb = bad[j] }
              c = "-" c; break
            }
          } else continue
          if (c == "--all" || c == "--tracked") al = any = 1
          else if (c == "--deleted") dl = any = 1
          else if (c ~ /^-(c|t|-change|-tag)$/) any = 1
          else if (c ~ /^-(b|-bookmark|-named)$/) {
            any = 1; if (c == "--named") sub(/=.*/, "", v); else sub(/^exact:/, "", v)
            say(!vb && v ~ /^[A-Za-z0-9._\/@+-]+$/ ? ":to" : ":?", v)
          }
          continue
        }
        if (!dd && x ~ /^--./) {
          c = substr(x, 3); sub(/=.*/, "", c); u = c ~ /^no-./; if (u) c = substr(c, 4)
          if (!u && c ~ /^help(-all)?$/) hp = 1
          else if (c ~ /^dr/ && index("dry-run", c) == 1) dr = !u
          else if (c == "force") fo = !u
          else if (index("force-with-lease", c) == 1) le = !u
          else if (!sp && index("delete", c) == 1) de = !u
          else if (!sp && index("prune", c) == 1) pr = !u
          else if (index("mirror", c) == 1) { mi = !u; if (u && !sp) fo = 0 }
          else if (index("all", c) == 1 || !sp && index("branches", c) == 1) ao = !u
          else if (sp && c ~ /^std/ && index("stdin", c) == 1) si = u ? "" : x
          else if (!sp && index("tags", c) == 1) tg = !u
          else if (!u && x !~ /=/ && (index(sp ? "remote" : "repo", c) == 1 || index("push-option", c) == 1 || index("receive-pack", c) == 1 || index("exec", c) == 1 || !sp && index("recurse-submodules", c) == 1)) j++
          continue
        }
        if (!dd && x ~ /^-./) {
          for (m = 2; m <= length(x); m++) {
            c = substr(x, m, 1)
            if (c == "f") fo = 1; else if (c == "n") dr = 1; else if (c == "h") hp = 1; else if (c == "d" && !sp) de = 1; else if (c == "o" && !sp) { if (m == length(x)) j++; break }
          }
          continue
        }
        # The first word is the repository, --repo or not; each after it a
        # refspec, or tag and the tag it names.
        if (++n == 1) { r = x; rb = bad[j]; continue }
        if (!sp && x == "tag" && !bad[j]) { j++; continue }
        ref(x, bad[j], g)
      }
      # No refspec: a repository word its text cannot fix may split into
      # some; else the command -c config refspecs, or matching (send-pack,
      # push.default=matching), or the branch checked out. Under xargs, its
      # input may add some.
      al = al || ao || mi; dl = dl || de || pr || mi
      if (t == "git" && n < 2 && !al && !tg && !dl && !xa) {
        if (rb) say(":?", r)
        else if (!sp && (s = conf(n ? r : "")) != "") { N = split(substr(s, 2), R, "\035"); for (m = 1; m <= N; m++) ref(R[m], 0, g) }
        else if (sp || pm) al = 1
        else head(g, "HEAD")
      }
      if (fo || le) put(":force")
      if (dl) put(":delete")
      if (al) put(":all")
      if (si != "") say(":?", si)
      if (t == "jj" && !any) say(":?", "jj git push")
      if (xa) say(":?", "xargs")
      if (!dr && !hp) printf "%s", pb
    }
    # The command word of the segment, past VAR=value prefixes, reserved
    # words and wrappers with their options, each that takes a value with it,
    # and timeout with its duration: its index, dg the directory it runs in
    # (env -C), gd the git dir a GIT_DIR prefix names, xa set under xargs. A
    # word that may expand to nothing (em), which bash drops, is skipped, le
    # set; so are the unquoted substitutions a word starts with (lit).
    function lead(   j, x, v, m, c, s, wr, du) {
      dg = cw; gd = ""; xa = 0; le = 0
      for (j = base + 1; j <= k; j++) {
        x = seg[j]
        if (em[j]) { le = 1; continue }
        if (x ~ /^[A-Za-z_][A-Za-z0-9_]*=/) { if (x ~ /^GIT_DIR=/) gd = bad[j] ? "?" : substr(x, 9); continue }
        x = lit(j)
        if (x ~ /^(env|command|builtin|exec|nohup|time|timeout|nice|xargs|!|[{]|[}]|then|else|elif|do|if|while|until)$/) { wr = x; du = x == "timeout"; xa = xa || x == "xargs"; continue }
        if (x !~ /^-/) { if (!du) break; du = 0; continue }
        if (x ~ /^--./) {
          c = substr(x, 3); m = index(c, "="); v = m ? substr(c, m + 1) : ""; if (m) c = substr(c, 1, m - 1)
          s = wr == "env" ? " unset chdir split-string" : wr == "timeout" ? " signal kill-after" : wr == "nice" ? " adjustment" : wr == "xargs" ? " arg-file delimiter max-args max-procs max-chars process-slot-var" : ""
          if (!index(s, " " c)) continue
          if (!m) v = seg[++j]
          if (wr == "env" && index("chdir", c) == 1) dg = bad[j] ? "" : path(dg, v)
          continue
        }
        s = wr == "env" ? "uCSP" : wr == "timeout" ? "sk" : wr == "nice" ? "n" : wr == "xargs" ? "adEIJLnPRSs" : wr == "exec" ? "a" : ""
        for (m = 2; m <= length(x); m++) if (index(s, c = substr(x, m, 1))) {
          v = m < length(x) ? substr(x, m + 1) : seg[++j]
          if (wr == "env" && c == "C") dg = bad[j] ? "" : path(dg, v)
          break
        }
      }
      return j
    }
    # Word j as a command name: past the unquoted substitutions it starts
    # with (pf long), which may expand to nothing, when the rest is plain;
    # lb when it is not, and le when it holds a substitution, which may.
    function lit(j) {
      lb = bad[j]; if (pf[j] || lb && (index(seg[j], "$(...)") || index(seg[j], "`...`"))) le = 1
      if (!pf[j] || bp[j] > pf[j]) return seg[j]
      lb = 0; return substr(seg[j], pf[j] + 1)
    }
    # The segment feeds its heredoc to a shell that reads its script from
    # stdin: sh, bash, dash, ksh or zsh with options alone, -s with its
    # arguments, and no -c.
    function shin(   j, x, s) {
      j = lead(); if (j > k) return 0
      x = lit(j); sub(/.*\//, "", x)
      if (lb || x !~ /^(ba|da|k|z)?sh$/) return 0
      for (j++; j <= k && seg[j] ~ /^-./ && seg[j] != "--"; j++) {
        if (seg[j] ~ /^-[^-]*c/) return 0
        if (seg[j] ~ /^-[^-]*s/) s = 1
        if (seg[j] ~ /^-[^-]*o$/) j++
      }
      if (seg[j] == "--") j++
      return j > k || s
    }
    function run(   j, x, t, g, n, m, v, vb, dd, a, p, ac, xb) {
      j = lead(); g = dg; cf = ""
      if (j > k) return
      # GIT and JJ run git and jj on a case-insensitive file system; git-push
      # and git-send-pack, by any path, git push and git send-pack. A name
      # read through a word its text cannot fix counts when its last part
      # is plain.
      x = lit(j); xb = lb; p = match(x, /.*\//) ? RLENGTH : 0; t = substr(x, p + 1)
      if (tolower(t) ~ /^(git|jj|git-push|git-send-pack)$/) t = tolower(t)
      # One past a word that may expand to nothing is unresolved: as the path
      # of a worktree add when the segment names one, else as a push target.
      if (xb && (bp[j] > p || t !~ /^(git|jj|git-push|git-send-pack)$/)) {
        if (le) { for (v = j + 1; v <= k && seg[v] !~ /^(worktree|workspace)$/; v++) ; gsub(/\n/, " ", x); print (v > k ? ":? " : "?") x }
        return
      }
      if (t == "git-push" || t == "git-send-pack") { push(j, "git", g, t == "git-send-pack", 0); return }
      if (t == "popd") { cw = ""; return }
      if (t == "cd" || t == "pushd") {
        if (le) { cw = ""; return }
        for (j++; j <= k && seg[j] ~ /^-./; j++) ;
        cw = j > k ? ENVIRON["HOME"] : bad[j] || seg[j] == "-" ? "" : path(cw, seg[j]); return
      }
      if (t != "git" && t != "jj") return
      n = 0; dd = 0
      for (j++; j <= k; j++) {
        x = seg[j]
        if (!dd && x == "--") { dd = 1; continue }
        if (!dd && t == "git" && x ~ /^(-h|--help|-v|--version)$/) return
        if (!dd && x ~ /^--/) {
          if (t == "git" && x ~ /^--git-dir(=|$)/) { if (x == "--git-dir") j++; gd = bad[j] ? "?" : x == "--git-dir" ? seg[j] : substr(x, 11) }
          else if (x ~ /^--(work-tree|namespace|config-env|super-prefix|attr-source|shallow-file|reason|repository|at-operation|at-op|color|config|config-file|config-toml|name|revision|message|sparse-patterns)$/) j++
          continue
        }
        if (!dd && x ~ /^-./) {
          for (m = 2; m <= length(x); m++) if (index("CcbBRrm", v = substr(x, m, 1))) {
            if (m < length(x)) { v = substr(x, m + 1); vb = bad[j] } else { j++; v = seg[j]; vb = bad[j] }
            if (t == "git" && substr(x, m, 1) == "C") g = vb ? "" : path(g, v)
            # The command -c config a push reads: help.autocorrect, push.default, remote.<name>.push.
            if (t == "git" && substr(x, m, 1) == "c" && !vb) { cf = cf "\035" v; if (tolower(v) ~ /^help\.autocorrect(=|$)/) ac = 1 }
            break
          }
          continue
        }
        if (++n == 1) a = x
        if (t == "git" && n == 1 && (x == "push" || x == "send-pack" || ac && typo(x, "push")) || t == "jj" && n == 2 && a == "git" && x == "push") { push(j, t, g, x == "send-pack", dd); return }
        if (n == 1 && x != (t == "git" ? "worktree" : "workspace") && (t == "git" || x != "git") || n == 2 && (a == "git" || x != "add")) return
        # A path that spans lines is unresolved, so no line of it reads as a tag.
        if (n == 3) { v = bad[j] ? "" : path(g, x); if (v ~ /\n/) v = ""; gsub(/\n/, " ", x); print (v == "" ? "?" x : v); return }
      }
    }
    # Region text s laid into CH after a gap, its lines indexed by their
    # first char: LN their length, OC (counted in ON) where each text
    # stands, as written and with its leading tabs stripped. Its first char.
    function reg(s,   A, m, i, p, l, t) {
      p = NC + 2; m = split(s, A, ""); for (i = 1; i <= m; i++) CH[p + i - 1] = A[i]
      NC = p + m - 1; m = split(s, A, "\n"); l = p
      for (i = 1; i <= m; i++) {
        t = A[i]; sub(/^\t+/, "", t); LN[l] = length(A[i])
        OC[p, 0, A[i], ++ON[p, 0, A[i]]] = l; OC[p, 1, t, ++ON[p, 1, t]] = l
        l += LN[l] + 1
      }
      return p
    }
    # Where the heredoc on word w that starts at p in region r ends, no
    # later than e: the first char of the first line there that reads w,
    # its leading tabs stripped when st, or 0. A region is read in order,
    # so the place of each word in its list (OP) only moves on.
    function term(r, p, e, w, st,   y, x) {
      y = r SUBSEP st SUBSEP w
      while (OP[y] < ON[y] && OC[y, OP[y] + 1] < p) OP[y]++
      x = OP[y] < ON[y] ? OC[y, OP[y] + 1] : 0
      return x <= e ? x : 0
    }
    # Text CH[i .. n] of region r, read as the shell reads it in time linear
    # in its length, each segment handed to run, its words from base on; st
    # when a <<- body has its lines tab-stripped. A frame opened here is
    # closed here, at the end of the text if not before, as its ) would: a
    # $( keeps the segment and word around it while its own commands are
    # read, and comes back as one word of them, unresolved; a ( keeps the
    # directory; a heredoc fed to a shell (shin, h) is read in place as a
    # script of its own up to the line that ends it (term), the directory
    # put back after it. A backtick ends at the first backtick no backslash
    # escapes, whatever quotes it crosses: its text, unescaped as bash does,
    # is read as a region of its own. A word of unquoted
    # substitutions alone may expand to nothing (ee, then em), as may those
    # a word starts with (ep long, then pf), a run of them kept as one.
    function lex(r, i, n, st,   c, d, e, x, y, z, q, w, o, b, wb, rd, sb, sv, op, want, hd, strip, hk, hs, ee, ep) {
      y = sd; q = w = want = hd = ""; o = b = wb = hk = hs = ep = 0; ee = 1
      for (; i <= n + 1; i++) {
        c = i <= n ? CH[i] : "\n"; e = rd = sb = 0
        if (q != "" && i <= n) {
          if (q == "\047") { if (c == "\047") q = ""; else w = w c }
          else if (c == "\"") q = ""
          else if (c == "\\") { d = i < n ? CH[i + 1] : ""; if (d == "$" || d == "`" || d == "\"" || d == "\\") { w = w d; i++ } else if (d == "\n") i++; else w = w c }
          else if (c == "$" && i < n && CH[i + 1] == "(") { sb = 1; i++ }
          else if (c == "`") sb = 2
          else { if (c == "$") { b = 1; wb = length(w) + 1 } w = w c }
          if (!sb) continue
        } else {
          if (q != "") { b = 1; wb = length(w); q = "" }
          if (c == "$" && i < n && CH[i + 1] == "(") { sb = 1; i++; o = 1 }
          else if (c == "`") { sb = 2; o = 1 }
          else if (c == "\047" || c == "\"") { q = c; o = 1; ee = 0 }
          else if (c == "\\") { if (i < n && (d = CH[++i]) != "\n") { w = w d; o = 1; ee = 0 } }
          else if (index("$*?[{", c) || c == "~" && !o) { w = w c; o = 1; b = 1; wb = length(w); ee = 0 }
          else if (c == "#" && !o) { while (i < n && CH[i + 1] != "\n") i++ }
          else if (c == " " || c == "\t") e = 1
          else if (c == "<" || c == ">" || c == "&" && i < n && CH[i + 1] == ">") { if (o && w ~ /^[0-9]+$/) o = 0; e = 1; rd = 1 }
          else if (index(";&|()\n", c)) e = 2
          else { w = w c; o = 1; ee = 0 }
        }
        if (sb == 2) {
          z = ""
          for (x = i + 1; x <= n && CH[x] != "`"; x++)
            if (CH[x] == "\\" && x < n) { x++; z = z (index(q == "" ? "$`\\" : "$`\\\"", CH[x]) ? "" : "\\") CH[x] }
            else z = z CH[x]
          i = x > n ? n : x; x = reg(z); z = cw; sv = base; base = k
          lex(x, x, NC, st)
          k = base; base = sv; cw = z
          w = (ee ? "" : w) "`...`"; b = 1; wb = length(w); if (ee) ep = wb
          continue
        }
        if (sb) {
          ft[++sd] = "$"; stk[sd] = cw; fq[sd] = q; fw[sd] = w; fwant[sd] = want; fhk[sd] = hk; fk[sd] = k; fbase[sd] = base; fee[sd] = ee; fep[sd] = ep
          base = k; q = w = want = ""; o = b = wb = hk = ep = 0; ee = 1
          continue
        }
        if (e && o) { if (want == "hd") { hd = w; hk = 1 } else if (want == "") { seg[++k] = w; bad[k] = b; bp[k] = wb; em[k] = ee; pf[k] = ep }; want = "" }
        if (e) { w = ""; o = b = wb = ep = 0; ee = 1 }
        if (rd) {
          op = c
          while (i < n && index(" << <<< <<- <& <> >> >& >| &> &>> ", " " op CH[i + 1] " ")) op = op CH[++i]
          want = op == "<<" || op == "<<-" ? "hd" : "skip"; strip = op == "<<-"
        }
        if (e == 2) {
          if (hk) { hs = shin(); hk = 0 }
          if (k > base) run()
          k = base; want = ""
          if (c == "(") { ft[++sd] = "("; stk[sd] = cw }
          else if (sd > y && ft[sd] != "h" && (c == ")" || i > n)) {
            cw = stk[sd]
            if (ft[sd] == "$") {
              k = fk[sd]; base = fbase[sd]; w = (fee[sd] ? "" : fw[sd]) "$(...)"; o = b = 1; wb = length(w); q = fq[sd]; want = fwant[sd]; hk = fhk[sd]; ee = fee[sd]; ep = ee ? wb : fep[sd]
            }
            sd--; if (i > n) i--
          }
          else if (sd > y && i > n) { cw = stk[sd]; n = fn[sd]; i = fi[sd]; st = fst[sd]; sd--; hd = ""; hk = hs = 0 }
          else if (c == "\n" && hd != "" && i <= n) {
            x = term(r, i + 1, n, hd, st || strip); z = x ? x + LN[x] : n; if (z > n) z = n
            if (hs) { ft[++sd] = "h"; stk[sd] = cw; fn[sd] = n; fi[sd] = z; fst[sd] = st; st = st || strip; if (x) n = x - 1 }
            else i = z
            hd = ""; hs = 0
          }
        }
      }
    }
    { s = s (NR > 1 ? "\n" : "") $0 }
    END { cw = "."; x = reg(s); lex(x, x, NC, 0) }')
}
# Path $1, physical, is where coddy keeps worktrees: under .worktrees/<issue>/
# or the agent's worktrees/<name>/ at the physical root $R.
coddywt() {
  case "$1" in "$R"/.worktrees/?*) return 0 ;; esac
  [ -n "${CODDY_AGENT_DIR-}" ] && case "$1" in "$R/$CODDY_AGENT_DIR"/worktrees/?*) return 0 ;; esac
  return 1
}
# A real directory sits at path $1, physically: not gone, moved or a link.
real() { [ -d "$1" ] && [ "$(cd "$1" 2>/dev/null && pwd -P)" = "$1" ]; }
# $1 holds no control character (C0, DEL, C1), backslash or quote.
clean() { local LC_ALL=C; case "$1" in *[[:cntrl:]\\\"\']*|*$'\xc2'[$'\x80'-$'\x9f']*) return 1 ;; esac; }
# $1 as one inert word, whatever the shell: in single quotes, a quote as '\'',
# a backslash as \134 and each byte of a control character (C0, DEL, C1) as
# \ooo, so it shows, keeps to one line and reads one way.
q() {
  local LC_ALL=C s=$1 o="'" c x
  while [ -n "$s" ]; do
    c=${s:0:1} s=${s:1}
    case "$c${s:0:1}" in
      \'*) o+="'\\''"; continue ;;
      \\*) o+='\134'; continue ;;
      $'\xc2'[$'\x80'-$'\x9f']) c+=${s:0:1} s=${s:1} ;;
      [[:cntrl:]]*) ;;
      *) o+=$c; continue ;;
    esac
    while [ -n "$c" ]; do printf -v x %d "'${c:0:1}"; printf -v x '\\%03o' $(((x + 256) % 256)); o+=$x c=${c:1}; done
  done
  printf '%s\n' "$o'"
}
# $1 as jj's escape_json writes it, its quotes aside.
json() {
  local LC_ALL=C s=$1 o="" c x
  while [ -n "$s" ]; do
    c=${s:0:1} s=${s:1}
    case "$c" in
      \"|\\) c="\\$c" ;;
      $'\b') c='\b' ;; $'\t') c='\t' ;; $'\n') c='\n' ;; $'\f') c='\f' ;; $'\r') c='\r' ;;
      [[:cntrl:]]) printf -v x %d "'$c"; [ "$x" = 127 ] || printf -v c '\\u%04x' "$x" ;;
    esac
    o+=$c
  done
  printf '%s\n' "$o"
}
# git worktree list --porcelain -z, or, from a git before 2.36, without -z:
# each path as one field, and one not followed by its HEAD or bare line
# taken with the lines up to it, so it holds a line break and is never
# skipped as coddy's (clean).
gitwts() {
  git worktree list --porcelain -z 2>/dev/null && return
  local l p=""
  while IFS= read -r l; do
    case "$l" in
      "HEAD "*|bare) [ -z "$p" ] || printf '%s\0' "$p"; p="" ;;
      "worktree "*) p=${p:+$p$'\n'}$l ;;
      *) [ -z "$p" ] || p+=$'\n'$l ;;
    esac
  done < <(git worktree list --porcelain 2>/dev/null)
  [ -z "$p" ] || printf '%s\n\0' "$p"
}
# gi: the git admin id worktree $1's .git names, when it is a plain file;
# its first line, read no further than a NUL or 1024 characters, so a huge
# or sparse file stalls no hook.
gid() { local l=""; [ -f "$1/.git" ] && { read -r -d '' -n 1024 l < "$1/.git"; } 2>/dev/null; l=${l%%$'\n'*}; case "$l" in "gitdir: "*/?*) gi=${l##*/} ;; *) return 1 ;; esac; }
# The branch the HEAD line in l names, trimmed as git trims it: nothing when
# HEAD is detached; status 1 when it names no branch git could have (a
# reftable repository's stub included).
headref() {
  [[ $l =~ ^[0-9a-fA-F]{40} ]] && return 0
  [[ $l =~ ^ref:[$' \t\n\r']*refs/heads/([^$' \t\n\r']+)[$' \t\n\r']*$ ]] && [[ /${BASH_REMATCH[1]} != */.* ]] || return 1
  echo "${BASH_REMATCH[1]}"
}
# The branch checked out in directory $1, physical, found as git finds it but
# never by git, which would run what a command planted there: at each level
# up, a .git that is a gitdir: file (git dies on a bad one; its first line
# read no further than a NUL or 1024 characters and trimmed as git trims
# it), or else a .git that is a repository (isgit; git walks past any
# other), or else the directory itself as a bare one (headref). Nothing when
# no repository holds $1 or HEAD is detached; status 1 when $1 is no
# directory, so a cd into it fails and leaves the shell where it was, or
# HEAD names no branch git could have.
branchin() {
  local g=$1 x l
  [ -d "$1" ] || return 1
  while :; do
    x="$g/.git"
    if [ -f "$x" ]; then
      { IFS= read -r -d '' -n 1024 l < "$x"; } 2>/dev/null; l=${l%"${l##*[!$'\n\r']}"}
      case "$l" in "gitdir: "?*) x=${l#gitdir: }; case "$x" in /*) ;; *) x="$g/$x" ;; esac ;; *) return 0 ;; esac
      isgit "$x"; break
    fi
    isgit "$x" || isgit "${g:-/}" && break
    [ -n "$g" ] || return 0
    g=${g%/*}
  done
  headref
}
# Outside worktree line $1, with its fd 3 records $2 and $3 ($3 may be
# empty); on fd 4 too, as "moved <line>" when snap recorded $2 ($seen,
# trip's alone), "kept <line>" when it recorded $3 alone, else "made
# <line>": trip tells a worktree line by that record, never by its text.
out() {
  echo "$1"
  if [[ $seen == *$'\n'"$2"$'\n'* ]]; then echo "moved $1"; elif [[ -n $3 && $seen == *$'\n'"$3"$'\n'* ]]; then echo "kept $1"; else echo "made $1"; fi >&4
}

# The main checkout's fingerprint: one line per dirty path with its content
# hash, one for the default branch $b when it holds commits its remote branch
# does not, and one for HEAD when it has left the default branch. A detached
# HEAD on the default branch's own history counts as on it: that is where jj
# leaves a synced checkout. Paths, not git status codes: jj colocation flips
# untracked files to intent-to-add on its own. One line, ending in the tool
# that removes it in parentheses, per git worktree and jj workspace outside
# coddy's (coddywt, and real: one moved away or reached through a link is
# listed), the main checkout aside, so one a command made is reported
# however it spelled it; jj names a workspace's path from 0.38 on and,
# before 0.46, not once its directory has gone, so such a workspace is left
# out. Each is read whole (NUL-separated from git, JSON-escaped from jj; line
# by line from a git before 2.36, gitwts) and every path and name is printed
# quoted (q), so none reads as a second entry. The root is matched as it is
# spelled (as jj escapes it, J), and only what follows it, when it holds no
# control character, quote or backslash (clean), is held to the test before
# an entry is skipped as the root or coddy's own. No line is a command.
# Every dirty file is hashed by one git hash-object; a path holding a newline
# is misread by --stdin-paths. A dirty path that is not clean is printed
# quoted (q), so none spans two lines. A submodule shows as one gone line
# once its commit leaves the one recorded for it, and not again while it
# stays off it; never for its work tree (--ignore-submodules=dirty): git
# reads the submodule's config, which a command can plant (its fsmonitor,
# filters and hooks), but runs nothing in it. No git or jj call here runs
# in a worktree the command could have made.
# On fd 3, one line each (git's as %q, jj's as it escapes them): every
# worktree's path, every git admin id (read from each worktree's .git and
# from the common dir, so one whose directory is gone is there too) and
# every jj workspace's name (one jj lists with no path included), coddy's
# and the root's included. trip passes them back as $seen (out).
snap() {
  cd "$root" 2>/dev/null || return 0
  git merge-base --is-ancestor "refs/heads/$b" "refs/remotes/origin/$b" 2>/dev/null ||
    { tip=$(git rev-parse -q --verify "refs/heads/$b" 2>/dev/null) && echo "commits on $b $tip"; }
  at=$(git symbolic-ref -q --short HEAD 2>/dev/null); h=$(git rev-parse HEAD 2>/dev/null)
  if [ -n "$at" ]; then
    [ "$at" = "$b" ] || echo "branch $at $h"
  elif ! git merge-base --is-ancestor HEAD "refs/remotes/origin/$b" 2>/dev/null; then
    echo "detached HEAD $h"
  fi
  while IFS= read -r -d '' p; do
    case "$p" in "worktree "*) p=${p#worktree } ;; *) continue ;; esac
    printf -v k 'path %q' "$p"; g=""; ! gid "$p" || printf -v g 'git %q' "$gi"
    printf '%s\n' "$k" ${g:+"$g"} >&3
    r=${p#"$R"}
    [ "$r" != "$p" ] && clean "$r" && { [ -z "$r" ] || { coddywt "$p" && real "$p"; }; } ||
      out "git worktree at $(q "$p") (git worktree remove)" "$k" "$g"
  done < <(gitwts)
  [ -z "$C" ] || for d in "$C"/worktrees/*/; do [ ! -d "$d" ] || { d=${d%/}; printf 'git %q\n' "${d##*/}" >&3; }; done
  # No colour or pager, whatever the config says. One listing: each name,
  # then its root when jj gives one. The root is matched in its escaped
  # form, J.
  [ ! -d .jj ] || { J=$(json "$R"); while IFS=$'\t' read -r w p; do
    [[ $w != \"*\" ]] || echo "jj ${w:1:${#w}-2}" >&3
    [ -n "$p" ] || continue
    [[ $p == \"*\" && $w == \"*\" ]] || { out "jj workspace $(q "$w") at $(q "$p") (jj workspace forget)" "jj $w" "path $p"; continue; }
    pi=${p:1:${#p}-2} wi=${w:1:${#w}-2}; r=${pi#"$J"}
    echo "path $pi" >&3
    [ "$r" != "$pi" ] && clean "$r$wi" && { [ -z "$r" ] || { coddywt "$R$r" && real "$R$r"; }; } ||
      out "jj workspace $(q "$wi") at $(q "$pi") (jj workspace forget)" "jj $wi" "path $pi"
  done < <(jj --no-pager workspace list --ignore-working-copy --color=never -T 'stringify(name).escape_json() ++ if(root, "\t" ++ stringify(root).escape_json()) ++ "\n"' 2>/dev/null); }
  files=() n=0
  while IFS= read -r -d '' e; do
    # A staged rename or copy carries its source in the next field: a rename's
    # source then reads as gone.
    set -- "${e:3}"
    case "$e" in [RC]*) IFS= read -r -d '' o; set -- "$1" "$o" ;; esac
    for p; do
      # The config paths are the lock's: a restored one differs from a pulled
      # HEAD, and that is not the command's change to undo.
      case "$p" in .coddy.yml|"$legacy") continue ;; esac
      [ -z "${CODDY_AGENT_DIR-}" ] || case "$p" in "$CODDY_AGENT_DIR"/*) continue ;; esac
      if [ -f "$p" ]; then files[n]="$p"; n=$((n+1)); else clean "$p" || p=$(q "$p"); printf '%s gone\n' "$p"; fi
    done
  done < <(git status --porcelain -uall -z --ignore-submodules=dirty 2>/dev/null)
  [ "$n" -gt 0 ] || return 0
  printf '%s\n' "${files[@]}" | git hash-object --stdin-paths 2>/dev/null |
    { i=0; while IFS= read -r hash; do p=${files[i]}; clean "$p" || p=$(q "$p"); printf '%s %s\n' "$p" "$hash"; i=$((i+1)); done; }
}

if [ "${1-}" = snap ] || [ "${1-}" = trip ]; then
  # The snapshot is named by the tool use; an id that is not a plain word
  # reads as none, so it cannot name a path outside TMPDIR. Read without jq:
  # onboard installs jq inside one command, so snap runs without it and trip
  # with it, and the name must come out the same on both sides. Inside a JSON
  # string a quote is escaped, so a bare "tool_use_id" is a key, never text.
  in=$(cat)
  id=$(sed -n 's/.*"tool_use_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$in" 2>/dev/null | head -n1)
  R=$(cd "$root" 2>/dev/null && pwd -P)
  # The git common dir the root was resolved from, physical, read past each
  # side's onboarding gate. seen is trip's alone (out).
  common() { C=$({ [ -n "$common" ] && cd "$dir" && cd "$common" && pwd -P; } 2>/dev/null); }
  seen=""
  case "$id" in ''|*[!A-Za-z0-9_-]*) id=shared ;; esac
  file="${TMPDIR:-/tmp}/coddy-snap-$(printf %s "$root" | cksum | cut -d' ' -f1)-$id"
  # Both config paths are kept, present or not: a .coddy.yml the command
  # makes next to a live .claude/coddy.yml would shadow it. Each path's
  # kind is recorded, with a copy of a file and the target of a link, so a
  # record the command removed is told from a path that was absent. A
  # config the user keeps as a link is kept as its content and its target.
  if [ "$1" = snap ]; then
    # A snapshot before every command, so trip can tell a command that
    # removed it from one run outside the workflow: NOT_ONBOARDED alone where
    # no config is, and the hooks stay inert. TMPDIR is the command's to
    # write too, so every record is a new file (set -C, O_EXCL), never one
    # through a link a command planted at its name, written before the
    # fingerprint's git calls give one time to; a write that fails drops
    # the snapshot, which trip reports as lost.
    set -C; rm -f "$file" "$file".*
    [ -f "$conf" ] || { echo NOT_ONBOARDED > "$file" || rm -f "$file"; exit 0; }
    oddly
    common
    b=$(cfg default_branch); b="${b:-main}" ok=1
    for c in .coddy.yml "$legacy"; do
      p="$root/$c" s="$file.${c//\//_}"
      kind "$p" > "$s.kind" && { [ ! -f "$p" ] || cat -- "$p" > "$s"; } && { [ ! -L "$p" ] || readlink "$p" > "$s.link"; } || ok=""
    done
    { snap 4>/dev/null | LC_ALL=C sort -u > "$file"; } 3>"$file.wt" || ok=""
    [ -n "$ok" ] || rm -f "$file"
    # A git worktree add or jj workspace add that would make a worktree
    # outside coddy's (coddywt) is refused before it runs, read from the
    # command's text (adds): a spelling it cannot read passes, saying so, and
    # the fingerprint reports the worktree once the command has run. So is a
    # git push, git send-pack or jj git push to the default branch, a force
    # push, the issue's own branch included, and a remote branch's delete,
    # which coddy leaves to a person; a target it cannot read passes, saying
    # so, and nothing reports it afterwards. The snapshot comes first, so
    # trip finds it whatever happens here. A push is named in any case, or
    # as send-pack, or under help.autocorrect by a typo.
    case "$in" in *worktree*|*workspace*|*[Pp][Uu][Ss][Hh]*|*send-pack*|*[Aa][Uu][Tt][Oo][Cc][Oo][Rr][Rr][Ee][Cc][Tt]*) ;; *) exit 0 ;; esac
    # A jq that is missing or does not run lets the command through, saying
    # so; one that runs and cannot read the payload is refused, since the
    # agent writes the payload (a lone surrogate escape in any field fails
    # jq) and could otherwise let any push through.
    command -v jq >/dev/null && jqh -n true >/dev/null 2>&1 ||
      { printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"coddy could not read this command for a git worktree add, a jj workspace add or a push, since jq is missing or failed, so it was let through: a worktree it makes outside .worktrees/<issue>/ is reported once it has run, a push is not."}}'; exit 0; }
    code=2 unk="" pu=""
    pr="Issue work reaches $b through a pull request: /coddy:ship pushes the issue's branch and opens one."
    warnmode command
    cmd=$(jqh -r '.tool_input.command // empty' <<<"$in") && cwd=$(jqh -r '.cwd // empty' <<<"$in") ||
      die "the shell hook could not read the hook payload with jq, so that command could not be checked for a git worktree add, a jj workspace add or a push."
    while IFS= read -r p; do
      case "$p" in
        \?*) unk="$unk ${p#\?}" ;;
        ":? "*) pu="$pu ${p#:? }" ;;
        ":to "*) [ "${p#:to }" != "$b" ] || die "that command would push to $b, the default branch. $pr" ;;
        ":glob "*) p=${p#:glob }; x=${p%%\**} p=${p#*\*}; case "refs/heads/$b" in "$x"*"$p") die "that command would push to $b, the default branch. $pr" ;; esac ;;
        :all) die "that command would push every branch, $b, the default branch, included. $pr" ;;
        :force) die "that command would force-push, which rewrites the remote's history, so coddy leaves it to a person." ;;
        :delete) die "that command would delete a remote branch, which coddy leaves to a person." ;;
        *) coddywt "$p" || die "that command would make a worktree at $p, outside .worktrees/<issue>/${CODDY_AGENT_DIR:+ and $CODDY_AGENT_DIR/worktrees/<name>/}. Issue work belongs in .worktrees/<issue>/: run /coddy:start <issue>, which makes it." ;;
      esac
    done < <(adds "$cmd" "${cwd:-$PWD}")
    [ -z "$unk" ] || unk="coddy could not tell where this command's git worktree add or jj workspace add puts its worktree (${unk# }), so it was let through: one it makes outside .worktrees/<issue>/ is reported once it has run."
    [ -z "$pu" ] || unk="${unk:+$unk }coddy could not tell which branch this command's push reaches (${pu# }), so it was let through: a push to $b, a force push and a branch delete are a person's to make."
    [ -z "$unk" ] || note "$unk"
    exit 0
  fi
  code=2 msg="" keep=""
  # The snapshot says whether the project was onboarded when the command
  # started, so trip never looks at the config first: the command may have
  # removed it, or made it. No snapshot, or one missing a path's record, or
  # the copy a file's record promises, is one the command touched, and then
  # what it did cannot be checked: rejected. Not onboarded then: quiet, the
  # command that wrote the config included. The live config as snap saw it
  # is the first path recorded as a file.
  lost="that command left no snapshot of the main checkout at $file, so what it changed cannot be checked: a command may not touch the snapshot. Undo what it did."
  [ -f "$file" ] || die "$lost"
  grep -qx NOT_ONBOARDED "$file" && { rm -f "$file" "$file".*; exit 0; }
  common
  pre=""
  for c in .coddy.yml "$legacy"; do
    s="$file.${c//\//_}"; k=""; [ ! -f "$s.kind" ] || k=$(cat "$s.kind")
    case "$k" in file) [ -f "$s" ] && pre="${pre:-$s}" ;; absent|dir|fifo|other) ;; *) false ;; esac || die "$lost"
  done
  [ -n "$pre" ] || die "$lost"
  # The config is the off switch for every hook here, so a shell command may
  # not change it: each path that changed is put back as it was, whatever
  # the command did. A pull or checkout that brought another config is put
  # back too, since nothing a shell command run as the same user can write
  # (a ref, an object, a git config) tells it from a forged one; the report
  # names /coddy:config, which accepts it from HEAD with the user's say-so.
  # A link that was not there, or points elsewhere, or a directory in the
  # file's place is a change whatever it holds: a link reaches a file the
  # lock does not watch; a link the user keeps there, as it was, is not.
  # What is put back is a plain file. TMPDIR is the command's to write too,
  # so nothing there is opened unless it is a plain file: a FIFO planted at
  # a snapshot name would hang trip. The legacy file is let go once
  # .coddy.yml is live (settled first, above): it is ignored then and cannot
  # change the effective config. The default branch is read from the
  # snapshot's copy of the config, as snap read it, not from what the
  # command left.
  b=$(cfg default_branch "$pre" 2>/dev/null); b="${b:-main}"
  for c in .coddy.yml "$legacy"; do
    p="$root/$c" s="$file.${c//\//_}"
    { [ "$c" = "$legacy" ] && [ -f "$root/.coddy.yml" ]; } && continue
    # Unchanged: the same link target (none for a plain file), the same kind
    # and, for a file, the same content.
    was=""; [ ! -f "$s.link" ] || was=$(cat "$s.link")
    k=""; [ ! -f "$s.kind" ] || k=$(cat "$s.kind")
    [ "$(readlink "$p" 2>/dev/null)" = "$was" ] && [ "$(kind "$p")" = "$k" ] && { [ "$k" != file ] || cmp -s "$p" "$s"; } && continue
    rm -rf "$p"
    # A copy that cannot be written back is kept, and the report says so,
    # rather than claiming the file is back.
    if [ ! -f "$s" ]; then what=removed
    elif mkdir -p "${p%/*}" && cp "$s" "$p"; then what=restored
    else what="removed, and could not be put back: restore it by hand from the copy at $s"; keep=1
    fi
    msg="${msg}that command changed $c, which switches the coddy guardrails, so it has been $what. "
  done
  [ -z "$msg" ] || msg="${msg}If that came from git (a pull or checkout), accept it with /coddy:config; other settings change there too, and leaving the workflow is for the user to do by hand. "
  confpath
  [ -z "$odd" ] || { rm -f "$file"; [ -n "$keep" ] || rm -f "$file".*; oddly "$msg"; }
  # Only lines that are new count, so undoing a change never trips the wire.
  # Every line is unique by design, so a repeat is no new line: git lists a
  # worktree twice once a command copies its admin dir. A new line is a
  # worktree's when the fingerprint wrote it on fd 4 too (out), never by its
  # text, which a dirty path's could copy: moved, renamed or re-created when
  # snap recorded its path, git admin id or jj name before the command
  # ($file.wt, opened only as a plain file), made otherwise. Each names, as
  # text, the tool that removes it, once what the directory holds is
  # checked, and the one that puts it back: git worktree move for a git
  # worktree not made, jj workspace rename for a jj workspace at a path snap
  # recorded under another name (kept: its name is out's $2, its path $3).
  # Any other line is the main checkout's, its last word, a hash or gone,
  # dropped.
  [ ! -f "$file.wt" ] || seen=$'\n'$(cat "$file.wt")$'\n'
  lab=$(mktemp 2>/dev/null) || lab=/dev/null
  new=$(snap 3>/dev/null 4>"$lab" | LC_ALL=C sort -u | LC_ALL=C comm -13 "$file" -)
  added="" wts=""
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    t="moved, renamed or re-created" a="git worktree move"
    if grep -qxF -- "made $l" "$lab"; then t=made a=""
    elif grep -qxF -- "moved $l" "$lab"; then case "$l" in jj*) a="" ;; esac
    elif grep -qxF -- "kept $l" "$lab"; then case "$l" in jj*) a="jj workspace rename" ;; esac
    else added="${added:+$added }${l% *}"; continue
    fi
    wts="${wts:+$wts; }${l% (*}, $t (${a:+put it back with $a, or }check what it holds before removing it with ${l##* (}"
  done <<<"$new"
  rm -f "$file"; [ "$lab" = /dev/null ] || rm -f "$lab"; [ -n "$keep" ] || rm -f "$file".*
  [ -n "$added" ] && msg="${msg}that command changed the main checkout: $added. Issue work belongs in .worktrees/<issue>/. Undo it. "
  [ -n "$wts" ] && msg="${msg}that command made, moved or renamed a worktree outside .worktrees/<issue>/: $wts. Issue work belongs in .worktrees/<issue>/: run /coddy:start <issue>, which makes it."
  [ -z "$msg" ] && exit 0
  die "$msg"
fi

# The git hooks start writes (hooks, below), for everyone, people included: a
# git commit on a branch, or a push to one, passes only on a branch a claimed
# issue owns, whichever session holds the claim, and never on the default
# branch. A detached HEAD commits (jj leaves the main checkout there); a tag,
# and the delete of a branch other than the default one, push. Then the hook
# core.hooksPath named before runs with the same arguments and stdin, and its
# exit is the hook's; not onboarded, that hook alone. git runs a hook at the
# top of its worktree, where the root is found.
if [ "${1-}" = githook ]; then
  h="${2-}"; case "$h" in pre-commit|pre-push) shift 2 ;; *) die "usage: $self githook pre-commit|pre-push" ;; esac
  [ -z "$odd" ] || oddly
  in=""; [ "$h" = pre-commit ] || { in=$(cat; echo x); in=${in%x}; }
  if [ -f "$conf" ]; then
    b=$(cfg default_branch); b="${b:-main}"
    no="is refused: issue work belongs on a claimed issue's branch. Run /coddy:start <issue>, or ${h#pre-} with --no-verify."
    claimed() { for r in "$root"/.git/coddy/*.branch; do [ "$(cat "$r" 2>/dev/null)" = "$1" ] && [ -e "${r%.branch}" ] && return 0; done; return 1; }
    if [ "$h" = pre-commit ]; then
      n=$(git symbolic-ref -q HEAD); n=${n#refs/heads/}
      [ -z "$n" ] || [ "$n" != "$b" ] || die "a commit on $b, the default branch, $no"
      [ -z "$n" ] || claimed "$n" || die "a commit on $n, which no claimed issue owns, $no"
    else
      while read -r _ lo r _; do
        case "$r" in refs/heads/*) n=${r#refs/heads/} ;; *) continue ;; esac
        [ "$n" != "$b" ] || die "a push to $b, the default branch, $no"
        case "$lo" in *[!0]*) claimed "$n" || die "a push to $n, which no claimed issue owns, $no" ;; esac
      done <<<"$in"
    fi
  fi
  # The previous hook from .git/config alone, where start recorded it: like
  # .git/hooks, a sandbox keeps it out of an agent's reach, since git runs
  # hooks outside the sandbox. .git/coddy is only data here.
  p=$(git config --file "$root/.git/config" coddy.previousHooksPath); p="${p:-$root/.git/hooks}/$h"
  # Never this hook again: a previous path that is another spelling of it would loop.
  { [ -x "$p" ] && [ ! "$p" -ef "$root/.git/hooks/coddy/$h" ]; } || exit 0
  [ "$h" = pre-push ] || exec "$p" "$@"
  printf %s "$in" | "$p" "$@"; exit
fi

if [ "${1-}" = doctor ]; then
  # a root outside git (a jj workspace with no .git) is a project when it holds a config
  [ -n "${proj-}" ] || [ -f "$conf" ] || exit "$bad"
  [ -z "$absorbed" ] || { gdmsg; exit 1; }
  # no git call below runs against a git dir that points at another repository
  [ -z "$odd" ] || { gdmsg; exit 1; }
  [ -f "$conf" ] || { echo "config: none (fix: /coddy:onboard)"; exit 1; }
fi
[ -z "$odd" ] || { [ "${1-}" = sweep ] && exit 0; oddly; }
[ -f "$conf" ] || { [ "${1-}" = sweep ] && exit 0; die "NOT_ONBOARDED"; }
# This file by a path the cd below leaves valid, for the git hooks start writes.
src="${BASH_SOURCE[0]-}"; case "$src" in /*|'') ;; *) src="$PWD/$src" ;; esac
cd "$root" || die "cannot enter $root"
# The answers onboarding saved go once the config is written, and only then
# (above: NOT_ONBOARDED before); starting over is removing the file by hand.
if [ "${1-}" = forget ]; then
  [ "${2-}" = answers ] || die "usage: $self forget answers"
  [ -n "${CODDY_AGENT_DIR-}" ] || die "forget answers needs CODDY_AGENT_DIR"
  f="$CODDY_AGENT_DIR/coddy/onboard-answers.json"
  rm -f "$f" || die "could not remove $f"
  echo "removed: $f"; exit 0
fi
# The config brought up to the current schema version: from:, to:, one
# changed: line per change (tracked: after a move, legacy: file|link|dir|other
# after a remove), then --- and the migrated file, every line and
# comment kept; no --- block when the file itself needs no change. Read-only:
# a shell write to the config is undone by trip, so /coddy:migrate writes it
# with the Write tool. No version is 0, the layout from before .coddy.yml.
# Step m<n> takes the file on stdin from version n-1 to n, d<n> says what it
# changed; the next schema change is one more pair and cur+1.
# m1 puts version after a leading --- marker and ends it as the file's first line ends (CRLF).
m1() { awk 'NR == 1 { e = /\r$/ ? "\r" : ""; if (/^---\r?$/) { print; print "version: 1" e; next }; print "version: 1" e }; !/^version:/; END { if (!NR) print "version: 1" }'; }
d1="add version: 1"
# m2 bumps version to 2 and, when the first worktree key is missing or empty (read as jj before 2),
# pins worktree: jj: in place of an empty one, else after the version line.
m2() { awk 'NR == 1 { e = /\r$/ ? "\r" : "" } { l[NR] = $0 } /^worktree:/ && !w { w = NR; if ($0 ~ /^worktree:[[:space:]]*["\047]?["\047]?[[:space:]]*(#.*)?\r?$/) r = NR } END { for (i = 1; i <= NR; i++) { if (i == r) print "worktree: jj" e; else if (l[i] ~ /^version:/) { if (!v++) { print "version: 2" e; if (!w) print "worktree: jj" e } } else print l[i] } }'; }
d2="add version: 2, and worktree: jj when no worktree key is set"
if [ "${1-}" = migrate ]; then
  # The skill Reads and Writes these paths, which follow a link: only plain files.
  { [ -L .coddy.yml ] || { [ -e .coddy.yml ] && [ ! -f .coddy.yml ]; }; } && die ".coddy.yml is a link or not a plain file: replace it with the config itself by hand"
  [ "$cname" != "$legacy" ] || [ ! -L "$legacy" ] || die "$legacy is a link: replace it with the config itself by hand"
  cur=2 v=$(cfg version | tr -d '[:space:]'); v=${v#"${v%%[!0]*}"}; v="${v:-0}"
  case "$v" in *[!0-9]*) die "version in $cname is not a whole number: $v" ;; esac
  # by length first, so a number too long for bash is refused without its error
  { [ "${#v}" -le 9 ] && [ "$v" -le "$cur" ]; } || die "$cname is at version $v, newer than this coddy knows ($cur): update the coddy plugin"
  echo "from: $v"; echo "to: $cur"
  # the x keeps the file's trailing blank lines through each $(...)
  out=$(cat "$conf"; echo x) n=$v; out=${out%x}
  while [ "$n" -lt "$cur" ]; do n=$((n + 1)); out=$(printf '%s' "$out" | "m$n"; echo x); out=${out%x}; d="d$n"; echo "changed: ${!d}"; done
  # tracked: whether git tracks the legacy file, so the skill keeps a personal
  # config personal without a git rule of its own in allowed-tools.
  if [ "$cname" = "$legacy" ]; then echo "changed: move $legacy -> .coddy.yml"
    if git ls-files --error-unmatch -- "$legacy" >/dev/null 2>&1; then echo "tracked: yes"; else echo "tracked: no"; fi
  elif [ -e "$legacy" ] || [ -L "$legacy" ]; then echo "changed: remove $legacy"
    # legacy: its kind, so the skill backs up a file, removes a link unread and leaves the rest to the user
    if [ -L "$legacy" ]; then echo "legacy: link"; elif [ -f "$legacy" ]; then echo "legacy: file"; elif [ -d "$legacy" ]; then echo "legacy: dir"; else echo "legacy: other"; fi
  fi
  { [ "$v" -lt "$cur" ] || [ "$cname" = "$legacy" ]; } || exit 0
  echo "---"; printf '%s' "$out"; exit 0
fi
cmd="${1-}" issue="${2-}"
[ "$cmd" = sweep ] || [ "$cmd" = doctor ] || case "$issue" in ''|*[!A-Za-z0-9_-]*) die "issue id must look like 42 or ABC-123, got '$issue'" ;; esac
wt=".worktrees/$issue" rec=".git/coddy/$issue.branch"
# No worktree key is git from version 2, jj below it (no version is 0, read as migrate does).
tool=$(cfg worktree)
if [ -z "$tool" ]; then v=$(cfg version | tr -d '[:space:]'); v=${v#"${v%%[!0]*}"}; case "$v" in ''|1) tool=jj ;; *) tool=git ;; esac; fi
base=$(cfg default_branch); base="${base:-main}"

# doctor in a project: one line per check, ok or the problem and a fix in plain
# text, and exit 1 on any problem, native Windows included (bad, set with the
# install lines). Reads only: no write, no fetch, no hook run.
if [ "$cmd" = doctor ]; then
  # config, git and the hook files are the project's to write: no control character reaches the terminal
  say() { echo "$1: $(printf %s "$2" | tr -d '[:cntrl:]')"; case "$2" in ok*) ;; *) bad=1 ;; esac; }
  # the same test migrate uses: a changed: line
  if mig=$(CODDY_ROOT="$root" bash "$src" migrate 2>&1); then
    if printf '%s\n' "$mig" | grep -q '^changed:'; then say config "$cname is behind the schema (fix: /coddy:migrate)"; else say config "ok ($cname)"; fi
  else say config "$cname cannot be migrated: ${mig%%$'\n'*}"; fi
  case "$tool" in git|jj) say worktree "ok ($tool)" ;; *) say worktree "unknown value '$tool' (fix: set it to git or jj with /coddy:config)" ;; esac
  # a root with no .git directory (jj alone) has no origin ref for git to see and no hooks path to set
  if [ ! -d "$root/.git" ]; then say default_branch "ok (not applicable: no .git at the root)"
  elif git rev-parse -q --verify "refs/remotes/origin/$base" >/dev/null 2>&1; then say default_branch "ok (origin/$base)"; else say default_branch "origin/$base is missing here (fix: fetch origin, or set default_branch with /coddy:config)"; fi
  for x in jq git; do if command -v "$x" >/dev/null 2>&1; then say "$x" ok; else say "$x" "missing (fix: install $x)"; fi; done
  if [ "$tool" = jj ]; then if command -v jj >/dev/null 2>&1; then say jj ok; else say jj "missing (fix: install jj, or set worktree to git with /coddy:config)"; fi; fi
  hp=$(git config core.hooksPath) gd="$root/.git/hooks/coddy" e=""
  case "$hp" in /*) [ "$hp" -ef "$gd" ] || e="core.hooksPath is $hp, not coddy's directory" ;; *) if [ -n "$hp" ]; then e="core.hooksPath is $hp, not coddy's directory"; else e="core.hooksPath is not set"; fi ;; esac
  for h in pre-commit pre-push; do
    [ -z "$e" ] || break
    f="$gd/$h"
    if ! { [ -f "$f" ] && [ ! -L "$f" ] && head -c 4096 "$f" | grep -q '^# Written by coddy start: '; }; then e="$h is missing or not one coddy start wrote"; break; fi
    [ -x "$f" ] || { e="$h is not executable, so git skips it"; break; }
    c=$(head -c 4096 "$f" | sed -n "s/^c='\(.*\)'\$/\1/p" | head -1); c=${c//"'\\''"/"'"}
    { [ -f "$c" ] && [ -x "$c" ]; } || command -v coddy >/dev/null 2>&1 || e="$h runs $c, which is gone, and coddy is not on PATH"
  done
  if [ ! -d "$root/.git" ]; then say hooks "ok (not applicable: no .git at the root)"
  elif [ -n "$e" ]; then say hooks "$e (fix: /coddy:start <issue>)"; else say hooks ok; fi
  if [ "$(cfg tracker)" = github ]; then
    w=.github/workflows/coddy.yml tpl="$inst/templates/coddy.yml"
    if [ -L .github ] || [ -L .github/workflows ] || [ -L "$w" ] || [ ! -f "$w" ]; then say pr_check "$w is missing or not a plain file (fix: copy $tpl to $w)"
    elif [ ! -f "$tpl" ]; then say pr_check "the install has no $tpl to compare $w with (fix: reinstall coddy)"
    elif ! cmp -s "$w" "$tpl"; then say pr_check "$w differs from $tpl (fix: copy it over $w)"
    else say pr_check ok; fi
  fi
  if [ ! -f AGENTS.md ]; then say agents_md "AGENTS.md is missing or not a plain file (fix: add the block in step 6 of $inst/skills/onboard/SKILL.md)"
  elif [ "$(wc -c < AGENTS.md)" -gt 1048576 ]; then say agents_md "AGENTS.md is over 1 MiB, not read (fix: check the coddy block by hand)"
  elif awk '/<!-- coddy:begin -->/ { b++; if (!bl) bl = NR } /<!-- coddy:end -->/ { e++; if (!el) el = NR } END { exit !(b == 1 && e == 1 && bl < el) }' <(head -c 1048576 AGENTS.md); then say agents_md ok
  else say agents_md "AGENTS.md needs exactly one coddy:begin marker before one coddy:end (fix: replace the block with the one in step 6 of $inst/skills/onboard/SKILL.md)"; fi
  exit "$bad"
fi

# The worktree sits on branch $1: checked out (git), an ancestor of @ (jj).
on() {
  if [ "$tool" = jj ]; then
    [ -n "$(jj -R "$wt" log --no-graph -r "bookmarks(exact:\"$1\") & ::@" -T '"x"' 2>/dev/null)" ]
  else
    [ "$(git -C "$wt" branch --show-current)" = "$1" ]
  fi
}
record() { mkdir -p .git/coddy && echo "$branch" > "$rec" || die "could not record the branch"; }
has() { [ -n "$(jj log --no-graph -r "$1" -T '"x"' 2>/dev/null)" ]; } # a jj revset matches
# The config's verify command, run in the worktree; its exit code is the result.
verify() {
  [ -d "$wt" ] || die "no worktree for $issue. Run /coddy:start $issue."
  v=$(cfg verify); [ -n "$v" ] || die "no verify command in $cname"
  (cd "$wt" && sh -c "$v")
}
# The git hooks, .git/hooks/coddy/: pre-commit and pre-push run githook
# through this coddy, else one on PATH, else refuse; each other hook the
# previous directory holds gets a pass-through in sh that never starts coddy,
# and a name it does not hold gets no file, so a hook git fires often
# (reference-transaction, on every ref update) costs nothing the project did
# not already pay. A pass-through whose hook has gone exits 0, so start
# deletes nothing, and overwrites only what it wrote: a hook manager installs
# into git's hooks path, which is this directory once start has run.
# core.hooksPath names the directory by its absolute path
# (git resolves a relative one per worktree); the one it named before, none
# included, is recorded in .git/config as coddy.previousHooksPath whenever it
# was not this one, so a rerun keeps the record, for githook to hand off to.
# git runs hooks outside a sandbox, so Claude Code's keeps writes out of
# .git/hooks and .git/config: what a hook runs lives in one or the other,
# never where a sandboxed command could rewrite it. start writes a hook, or
# .git/config, only when it would change, so a rerun with nothing to change
# passes inside the sandbox.
hooks() {
  local q="'\''" c d e f g h p o m s new=""
  { [ -L .git/hooks ] || [ -L .git/hooks/coddy ]; } && die ".git/hooks or .git/hooks/coddy is a symlink: coddy writes its git hooks into .git/hooks/coddy, which a sandbox keeps out of an agent's reach. Replace the link with a directory (to keep hooks in the directory it links to, point core.hooksPath there instead), then run /coddy:start $issue again."
  c="$(cd "${src%/*}" && pwd)/${src##*/}" || die "could not find $src"
  # A write that fails names the sandbox only when the system says so, with
  # the one way past it, for the user.
  nowrite() {
    case "$2" in
      *'Operation not permitted'*) die "$1: $2. A sandbox blocks it, since git runs these hooks outside the sandbox. Install them once from your own terminal, not through an agent: cd $(printf %q "$root") && $(printf %q "$c") start $issue $(printf %q "$branch"). Later runs change nothing there, so they pass inside the sandbox." ;;
      *) die "$1: $2" ;;
    esac
  }
  [ -d .git/hooks/coddy ] || { e=$(mkdir -p .git/hooks/coddy 2>&1) || nowrite "could not make .git/hooks/coddy" "$e"; }
  d=$(cd .git/hooks/coddy && pwd) || die "cannot enter .git/hooks/coddy"
  # Hook $1 holds $2 unless it does already: written aside under a dot name and
  # moved in, since a hook cut short, or read while it is rewritten, would run
  # as an empty script and pass.
  put() {
    [ -x "$d/$1" ] && printf %s "$2" | cmp -s - "$d/$1" && return 0
    e=$( { printf %s "$2" > "$d/.$1.$$" && chmod +x "$d/.$1.$$" && mv -f "$d/.$1.$$" "$d/$1"; } 2>&1 ) || nowrite "could not write $d/$1" "$e"
  }
  # This directory by any spelling of the root, and absolute: git resolves a
  # relative core.hooksPath per worktree.
  ours() { case "$1" in /*) [ "$1" -ef "$d" ] ;; *) return 1 ;; esac; }
  p=$(git config --local coddy.previousHooksPath)
  if ! ours "$(git config core.hooksPath)"; then
    new=1 o=$(git config --type=path core.hooksPath)
    # this directory by another spelling is not a hook to hand off to
    { [ -n "$o" ] && [ "$o" -ef "$d" ]; } || p=$o
  fi
  g="${p:-${d%/coddy}}"
  # Every name here is a plain file start wrote (its temps are dotfiles, which * skips).
  for f in "$d"/*; do
    { [ -e "$f" ] || [ -L "$f" ]; } || continue
    { [ -f "$f" ] && [ ! -L "$f" ] && grep -q '^# Written by coddy start: ' "$f"; } || die "$f is not a hook coddy start wrote: a tool that installs into git's hooks path put it there. Move it to $g, where coddy runs it after its check, then run /coddy:start $issue again."
  done
  # git hook names hold no dot (a .sample does) and are files (not this
  # directory, under .git/hooks); never this directory again, or it would loop;
  # never coddy's own two by another name (PRE-COMMIT on a case-insensitive file system)
  pass() { case "$1" in pre-commit|pre-push|*.*) return 1 ;; esac; [ -f "$g/$1" ] && [ -x "$g/$1" ] && [ ! "$g" -ef "$d" ] && [ ! "$d/$1" -ef "$d/pre-commit" ] && [ ! "$d/$1" -ef "$d/pre-push" ]; }
  if [ -n "$p" ]; then o="git config core.hooksPath $(printf %q "$p")"; else o="git config --unset core.hooksPath"; fi
  for h in pre-commit pre-push; do
    m="coddy: cannot find coddy to check this ${h#pre-}. Run /coddy:start <issue> to rewrite these hooks, skip the check with --no-verify, or turn it off: $o"
    printf -v s '#!/bin/sh\n# Written by coddy start: coddy githook refuses a commit or push outside a claimed issue branch, then runs the hook core.hooksPath named before.\nc=%s\n[ -x "$c" ] || c=$(command -v coddy) || { printf "%%s\\n" %s >&2; exit 1; }\n# git runs this at the top of the worktree, where coddy finds the root.\nunset CODDY_ROOT\nexec "$c" githook %s "$@"\n' "'${c//\'/$q}'" "'${m//\'/$q}'" "$h"
    put "$h" "$s"
  done
  # Read back as git resolves it, at the root and in the issue's worktree, before
  # any pass-through is written: a value set where it overrides .git/config (a
  # worktree's own config, an include after [core], one on a condition such as
  # onbranch, GIT_CONFIG_*) would keep these hooks off, so .git/config's is put
  # back and nothing recorded. A first install racing another can fail on
  # .git/config.lock, which is fine once the value is this one.
  o=$(git config --local core.hooksPath)
  if [ -n "$new" ] && ! e=$(git config core.hooksPath "$d" 2>&1) && ! ours "$(git config core.hooksPath)"; then
    nowrite "could not set core.hooksPath in .git/config" "$e"
  fi
  if ! ours "$(git config core.hooksPath)" || ! ours "$(git -C "$wt" config core.hooksPath)"; then
    [ -z "$new" ] || if [ -n "$o" ]; then git config core.hooksPath "$o"; else git config --unset core.hooksPath; fi
    die "core.hooksPath is set where it overrides .git/config, so git would not run the coddy git hooks. Find it with git config --show-origin core.hooksPath, at the root and in $wt, remove it, then run /coddy:start $issue again."
  fi
  [ -z "$new" ] || { e=$(git config coddy.previousHooksPath "$p" 2>&1) || nowrite "could not record the previous core.hooksPath in .git/config" "$e"; }
  for f in "$g"/*; do
    h=${f##*/}; pass "$h" || continue; f="'${g//\'/$q}/${h//\'/$q}'"
    printf -v s '#!/bin/sh\n# Written by coddy start: runs the hook of this name core.hooksPath named before.\n[ -x %s ] || exit 0\nexec %s "$@"\n' "$f" "$f"
    put "$h" "$s"
  done
}

case "$cmd" in
  start|create)
    branch="${3-}"; [ -n "$branch" ] || die "usage: $self $cmd <issue> <branch> [base-issue]"
    [ -n "$src" ] || die "$cmd needs to run from its file, not stdin: the git hooks it installs run coddy by that path"
    [ "$branch" != "$base" ] || die "$base is the default branch, not an issue branch"
    # A new branch starts from $base on the remote, or, given a base issue,
    # from that issue's recorded branch as it stands here (pushed or not),
    # which is recorded too and becomes the PR's base in ship.
    onto="${4-}" from=""
    if [ -n "$onto" ]; then
      case "$onto" in *[!A-Za-z0-9_-]*) die "base issue id must look like 42 or ABC-123, got '$onto'" ;; esac
      from=$(cat ".git/coddy/$onto.branch" 2>/dev/null); [ -n "$from" ] || die "issue $onto has no worktree here to stack on. Run /coddy:start $onto first."
    fi
    other=$(grep -lxF -- "$branch" .git/coddy/*.branch 2>/dev/null | grep -vxF -- "$rec" | head -1)
    [ -z "$other" ] || die "branch $branch belongs to issue $(basename "$other" .branch)"
    if [ -d "$wt" ]; then
      if [ -s "$rec" ]; then
        [ "$(cat "$rec")" = "$branch" ] || die "$wt is on $(cat "$rec"), not $branch"
      else
        # A worktree from before the branch was recorded: record it now, but
        # only a branch the worktree really is on.
        on "$branch" || die "$wt is not on $branch"
        record
      fi
      hooks; echo "exists: $wt"; exit 0
    fi
    mkdir -p .worktrees
    git check-ignore -q .worktrees || echo '.worktrees/' >> .git/info/exclude
    # A branch that exists, here or only on the remote, is continued; any
    # other name starts a new branch from $base.
    if [ "$tool" = jj ]; then
      command -v jj >/dev/null || die "jj is not installed. Install it or set 'worktree: git' in $cname."
      [ -d .jj ] || die "this repo is not jj-backed. Ask the user, then run: jj git init --colocate && echo '.jj/' >> .git/info/exclude"
      jj git fetch || die "fetch failed"
      mine="bookmarks(exact:\"$branch\")"
      if ! has "$mine" && has "remote_bookmarks(exact:\"$branch\", exact:\"origin\")"; then
        jj bookmark track "$branch@origin" || die "could not track $branch@origin"
      fi
      if has "$mine"; then
        jj workspace add --name "$issue" -r "\"$branch\"" "$wt" || die "could not create the jj workspace"
      else
        start="$base@origin"; [ -z "$from" ] || start="\"$from\""
        jj workspace add --name "$issue" -r "$start" "$wt" || die "could not create the jj workspace"
        jj -R "$wt" bookmark create "$branch" -r @ || die "could not create branch $branch"
      fi
    else
      git fetch origin || die "fetch failed"
      if git show-ref -q "refs/heads/$branch" "refs/remotes/origin/$branch"; then
        git worktree add "$wt" "$branch" || die "could not create the git worktree"
      else
        git worktree add --no-track -b "$branch" "$wt" "${from:-origin/$base}" || die "could not create the git worktree"
      fi
    fi
    record
    [ -z "$from" ] || echo "$from" > ".git/coddy/$issue.base" || die "could not record the base"
    hooks
    echo "created: $wt on $branch${from:+ onto $from}" ;;

  claim)
    [ -d "$wt" ] || die "create the worktree first: $self create $issue <branch>"
    lock=".git/coddy/$issue" me="${CODDY_SESSION-}" note="" own="" again=""
    # A marker from before claims were locks is a plain file: nobody owns it;
    # the claim replaces it. rm -f never removes the lock another session
    # just made of it, so the mkdir race stays atomic.
    [ -f "$lock" ] && rm -f "$lock"
    mkdir -p .git/coddy || die "could not record the claim"
    if ! mkdir "$lock" 2>/dev/null; then
      for i in 1 2 3 4 5; do [ -s "$lock/owner" ] && break; sleep 0.1; done # the winner writes owner right after its mkdir
      owner "$issue"
      if [ ! -s "$lock/owner" ]; then
        # A claim in flight, or one that died between its mkdir and its owner line.
        [ "${3-}" = --take ] || die "issue $issue is being claimed right now, or that claim died halfway: retry, or take it over with bash \"$0\" claim $issue --take"
      # A re-claim: the lock then names this session's current id and pid
      # (/clear changes the one, --resume the other); $own stays, for the trap.
      elif mine; then again=1
      elif [ "${3-}" = --take ]; then note="taken over: $issue from session $sid (--take)"
      elif ! alive "$pid" "$start"; then note="taken over: $issue from session $sid (pid $pid is not running)"
      else die "issue $issue is claimed by session $sid (pid $pid, running). To take it over deliberately: bash \"$0\" claim $issue --take"
      fi
    fi
    # A claim whose owner line cannot be written leaves no lock behind; a
    # takeover that fails hands the lock back to its owner as it was.
    trap 'if [ -n "$own" ]; then echo "$own" > "$lock/owner"; else rm -rf "$lock"; fi' EXIT
    # ponytail: the tracker is reachable only through MCP tools, so this
    # records the transition the skill just made instead of verifying it.
    # Upgrade path: a PostToolUse hook on the tracker's write tool.
    myline > "$lock/owner" || die "could not record the claim"
    trap - EXIT
    [ -z "$note" ] || echo "$note"
    if [ -n "$again" ]; then echo "claimed: $issue (already by this session)"; else echo "claimed: $issue"; fi ;;

  ship|push)
    msg="${3-}"
    [ -d "$wt" ] || die "no worktree for $issue. Run /coddy:start $issue."
    [ -e ".git/coddy/$issue" ] || die "issue $issue is not In Progress. Run /coddy:start $issue."
    # Held to the lock's owner as the guard is: a lock or a push that names
    # no session (a script run by hand) is not.
    me="${CODDY_SESSION-}"; owner "$issue"
    [ -z "$sid" ] || [ -z "$me" ] || mine || die "the worktree of issue $issue belongs to session $sid (pid $pid, $(alive "$pid" "$start" && echo running || echo "not running")). Ship it from that session, or run /coddy:start $issue to take it over."
    # The branch create recorded, never one read off the history: once $base
    # is merged in, the history holds the branches of merged issues too.
    branch=$(cat "$rec" 2>/dev/null)
    [ -n "$branch" ] || die "no branch recorded for $issue. Record it: $self create $issue <branch>"
    if [ "$cmd" = ship ]; then verify; r=$?; [ "$r" = 0 ] || die "verify failed (exit $r): fix it in $wt before shipping"; fi
    [ "$branch" != "$base" ] && on "$branch" || die "$wt is not on issue branch $branch"
    if [ "$tool" = jj ]; then dirty=$(jj -R "$wt" diff --summary); else dirty=$(git -C "$wt" status --porcelain); fi
    if [ -n "$dirty" ]; then
      [ -n "$msg" ] || die "uncommitted changes in $wt: pass a commit message"
      if [ "$tool" = jj ]; then
        jj -R "$wt" commit -m "$msg" || die "commit failed"
      else
        git -C "$wt" add -A && git -C "$wt" commit -q -m "$msg" || die "commit failed"
      fi
    fi
    if [ "$tool" = jj ]; then
      jj -R "$wt" bookmark set "$branch" -r @- || die "nothing committed on $branch"
      jj -R "$wt" git push --bookmark "$branch" || die "push failed"
    else
      git -C "$wt" push -u origin HEAD || die "push failed"
    fi
    echo "pushed: $branch" ;;

  sweep)
    # Runs at skill load (next, start): quiet, never failing, and whatever it
    # cannot prove finished stays. Finished means the worktree's work reached
    # $base on the remote and nothing is uncommitted: read from git alone, no
    # tracker. On $base's own first-parent line the last commit is a worktree
    # started from $base with nothing of its own yet, which stays.
    git fetch -q origin "$base" >/dev/null 2>&1
    line=$(git rev-list --first-parent "origin/$base" 2>/dev/null)
    # $tip landed in origin/$base: as an ancestor (a merge commit), as an
    # upstream copy of every commit since the fork (a rebase merge), or as one
    # upstream commit holding the fork's whole diff (a squash merge).
    # ponytail: matched by patch id, so a squash or rebase whose conflicts
    # were resolved upstream is not seen and stays; read the PR state if that bites.
    landed() {
      if git merge-base --is-ancestor "$tip" "origin/$base" 2>/dev/null; then
        case "$line" in *"$tip"*) return 1 ;; esac; return 0
      fi
      fork=$(git merge-base "$tip" "origin/$base" 2>/dev/null) || return 1
      cherry=$(git cherry "origin/$base" "$tip" "$fork" 2>/dev/null) || return 1
      [ -n "$cherry" ] && ! grep -q '^+' <<<"$cherry" && return 0
      id=$(git diff "$fork" "$tip" 2>/dev/null | git patch-id --stable | cut -d' ' -f1)
      [ -n "$id" ] && git log -p --no-merges "$fork..origin/$base" 2>/dev/null | git patch-id --stable | grep -q "^$id "
    }
    for rec in .git/coddy/*.branch; do
      issue=$(basename "$rec" .branch); wt=".worktrees/$issue"; branch=$(cat "$rec" 2>/dev/null)
      case "$issue" in ''|*[!A-Za-z0-9_-]*) continue ;; esac
      [ -n "$branch" ] && [ -e ".git/coddy/$issue" ] && [ -d "$wt" ] || continue
      # ponytail: compared as strings, so a session that reached its
      # worktree through a symlink is not recognised as being inside it.
      case "${CODDY_ROOT-}/ ${OLDPWD-}/" in *"$root/$wt/"*) continue ;; esac
      if [ "$tool" = jj ]; then
        tip=$(jj -R "$wt" log --no-graph -r @- -T commit_id 2>/dev/null); dirty=$(jj -R "$wt" diff --summary 2>/dev/null)
      else
        tip=$(git -C "$wt" rev-parse HEAD 2>/dev/null); dirty=$(git -C "$wt" status --porcelain 2>/dev/null)
      fi
      [ -n "$tip" ] && landed || continue
      # Another session whose process still runs keeps its worktree, as the
      # guard and push hold to the lock's owner: a gone owner, a lock with no
      # owner or this session's own are swept.
      me="${CODDY_SESSION-}"; owner "$issue"
      if [ -n "$sid" ] && ! mine && alive "$pid" "$start"; then
        echo "kept: $issue (merged into $base, session $sid still holds it)"; continue
      fi
      if [ -n "$dirty" ]; then echo "kept: $issue (merged into $base, but $wt holds uncommitted work)"; continue; fi
      if [ "$tool" = jj ]; then
        jj workspace forget "$issue" >/dev/null 2>&1 || continue
        rm -rf "$wt"; jj bookmark forget "$branch" >/dev/null 2>&1
      else
        git worktree remove "$wt" >/dev/null 2>&1 || continue
        git branch -D "$branch" >/dev/null 2>&1
      fi
      rm -rf ".git/coddy/$issue" "$rec" ".git/coddy/$issue.base"; echo "cleaned: $issue"
    done
    exit 0 ;;

  verify) verify; exit $? ;;

  diff|log)
    [ -d "$wt" ] || die "no worktree for $issue. Run /coddy:start $issue."
    # The stacked base, while its branch still resolves (a merged base is
    # removed by sweep); else default_branch on the remote.
    from=$(cat ".git/coddy/$issue.base" 2>/dev/null)
    if [ -n "$from" ]; then
      if [ "$tool" = jj ]; then has "\"$from\"" || from=""; else git rev-parse -q --verify "refs/heads/$from" >/dev/null || from=""; fi
    fi
    if [ "$cmd" = log ]; then
      shift 2; git log --oneline -15 "${from:-origin/$base}" -- "$@"; exit $?
    fi
    if [ "$tool" = jj ]; then
      if [ -n "$from" ]; then from="\"$from\""; else from="$base@origin"; fi
      jj -R "$wt" diff -r "$from..@"
    else
      git -C "$wt" diff "${from:-origin/$base}...HEAD"
    fi
    exit $? ;;

  state)
    # start's phase state: key=value lines in the lock directory, so sweep
    # removes them with the lock. Anyone may read; only the lock's owner
    # writes, held as push is. Values are written, never evaluated.
    lock=".git/coddy/$issue" f=".git/coddy/$issue/state"
    [ -e "$lock" ] || die "issue $issue is not In Progress. Run /coddy:start $issue."
    [ $# -gt 2 ] || { cat "$f" 2>/dev/null; exit 0; }
    [ -d "$lock" ] || die "issue $issue's claim is from before locks. Run /coddy:start $issue to re-claim it."
    me="${CODDY_SESSION-}"; owner "$issue"
    [ -z "$sid" ] || [ -z "$me" ] || mine || die "the worktree of issue $issue belongs to session $sid. Run /coddy:start $issue to take it over."
    shift 2
    for kv; do # validate everything first: a bad argument writes nothing
      case "$kv" in *=*) ;; *) die "state takes key=value or key+=value, got '$kv'" ;; esac
      k="${kv%%=*}" v="${kv#*=}"
      case "$k" in *+) k="${k%+}" ;; esac
      case "$k" in ''|*[!abcdefghijklmnopqrstuvwxyz_]*) die "state keys are lower case words, got '$k'" ;; esac
      case "$v" in *"
"*) die "state values are one line" ;; esac
    done
    for kv; do
      k="${kv%%=*}" v="${kv#*=}" add=""
      case "$k" in *+) add=1 k="${k%+}" ;; esac
      if [ -n "$add" ]; then
        printf '%s=%s\n' "$k" "$v" >> "$f" || die "could not write $f"
      else
        { grep -v "^$k=" "$f" 2>/dev/null; printf '%s=%s\n' "$k" "$v"; } > "$f.tmp" && mv "$f.tmp" "$f" || die "could not write $f"
      fi
    done ;;
  *) die "usage: $self start|create <issue> <branch> [base-issue] | claim <issue> [--take] | ship|push <issue> [message] | state <issue> [key=value ...] | verify <issue> | diff <issue> | log <issue> <path>... | sweep | status | config | detect | exclude answers|config | forget answers | migrate | doctor | guard | githook pre-commit|pre-push" ;;
esac
